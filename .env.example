# ============================================================
# Cococabana — Environment Variable Reference
# Copy to .env for local development
# NEVER commit .env to version control
# ============================================================

# ─── Site ────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://cococabanaoside.com

# ─── Analytics ───────────────────────────────────────────────
PUBLIC_GA_MEASUREMENT_ID=

# ─── Google Business Profile ─────────────────────────────────
# Set to the current total review count from your Google Business Profile.
# Leave unset or set to 0 to suppress the aggregateRating schema block (no star ratings in SERPs).
PUBLIC_GOOGLE_REVIEW_COUNT=0
