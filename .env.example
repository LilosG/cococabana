# ============================================================
# Cococabana — Environment Variable Reference
# Copy to .env for local development
# NEVER commit .env to version control
# ============================================================

# ─── Site ────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://cococabanaoside.com

# ─── Analytics ───────────────────────────────────────────────
PUBLIC_GA_MEASUREMENT_ID=

# ─── Google Places API (aggregateRating schema) ──────────────
# Used at build time to fetch live rating and review count from Google Places API.
# Both values required — if either is missing, aggregateRating schema is omitted.
# Set these in Vercel environment variables (not .env) for production builds.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
