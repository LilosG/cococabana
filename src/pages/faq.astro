---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import { venue } from '../data/venue';
import { faqs } from '../data/faqs';
import { faqPage } from '../lib/cms';
import { getPhoto } from '../utils/images';

const faqSchema = {
  "@type": "FAQPage",
  "@id": "https://cococabanaoside.com/faq#faq",
  "url": "https://cococabanaoside.com/faq",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
    },
  })),
};
---

<Layout
  transparentNav={true}
  title={faqPage.seoTitle}
  description={faqPage.seoDescription}
  extraGraph={[faqSchema]}
>
  <PageHero
    image={getPhoto(faqPage.heroImage.src)}
    imageAlt={faqPage.heroImage.alt}
  >
    <Eyebrow tone="dark">{faqPage.heroEyebrow}</Eyebrow>
    <h1 class="font-display leading-ultra text-hero uppercase mb-6">{faqPage.heroTitle}</h1>
    <p class="text-brand-cream/80 leading-relaxed max-w-xl mb-8">{faqPage.heroText}</p>
    <Button href={venue.reservationsUrl} variant="primary" external>{faqPage.primaryCtaText}</Button>
  </PageHero>

  <!-- Q&A LIST -->
  <section class="bg-brand-cream px-6 sm:px-8 lg:px-12 py-20 sm:py-28">
    <div class="max-w-2xl mx-auto divide-y divide-brand-charcoal/10">
      {faqs.map(faq => (
        <div class="py-8 first:pt-0 last:pb-0">
          <h2 class="font-display text-lg uppercase tracking-feature text-brand-charcoal mb-3">
            {faq.question}
          </h2>
          <p class="text-brand-charcoal/70 leading-relaxed">{faq.answer}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-brand-charcoal px-6 sm:px-8 lg:px-12 py-16 sm:py-20 text-center">
    <Eyebrow align="center" tone="dark">{faqPage.finalCta.eyebrow}</Eyebrow>
    <h2 class="font-display text-section-xl leading-display uppercase text-brand-cream mb-8">{faqPage.finalCta.title}</h2>
    <div class="flex flex-wrap gap-4 justify-center">
      <Button href={venue.reservationsUrl} variant="primary" external>{faqPage.finalCta.primaryCtaText}</Button>
      <Button href={venue.routes.brunch} variant="ghost">{faqPage.finalCta.secondaryCtaText}</Button>
      <Button href={venue.routes.contact} variant="ghost">{faqPage.finalCta.tertiaryCtaText}</Button>
    </div>
  </section>
</Layout>
