---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import { venue } from '../data/venue';
import { faqs } from '../data/faqs';

const faqSchema = {
  "@type": "FAQPage",
  "@id": "https://cococabanaoside.com/faq#faq",
  "url": "https://cococabanaoside.com/faq",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer,
    },
  })),
};
---

<Layout
  title={`FAQ | ${venue.fullName} | ${venue.address.city}, ${venue.address.state}`}
  description={`Frequently asked questions about ${venue.name} — hours, reservations, brunch, parking, pets, and more.`}
  extraGraph={[faqSchema]}
>
  <!-- HEADER -->
  <section class="bg-brand-navy px-6 sm:px-8 lg:px-12 pt-40 pb-20 sm:pt-48 sm:pb-28 text-center">
    <Eyebrow align="center" tone="dark">{venue.address.city}, {venue.address.state}</Eyebrow>
    <h1 class="font-display leading-ultra text-hero uppercase text-brand-cream mb-4">FAQ</h1>
    <p class="text-brand-cream/70 leading-relaxed max-w-xl mx-auto">
      Everything you need to know before your visit.
    </p>
  </section>

  <!-- Q&A LIST -->
  <section class="bg-brand-cream px-6 sm:px-8 lg:px-12 py-20 sm:py-28">
    <div class="max-w-2xl mx-auto divide-y divide-brand-charcoal/10">
      {faqs.map(faq => (
        <div class="py-8 first:pt-0 last:pb-0">
          <h2 class="font-display text-lg uppercase tracking-feature text-brand-charcoal mb-3">
            {faq.question}
          </h2>
          <p class="text-brand-charcoal/70 leading-relaxed">{faq.answer}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-brand-charcoal px-6 sm:px-8 lg:px-12 py-16 sm:py-20 text-center">
    <Eyebrow align="center" tone="dark">Ready to Visit?</Eyebrow>
    <h2 class="font-display text-section-xl leading-display uppercase text-brand-cream mb-8">
      Reserve Your Table
    </h2>
    <div class="flex flex-wrap gap-4 justify-center">
      <Button href={venue.reservationsUrl} variant="primary" external>Reserve Now</Button>
      <Button href={venue.routes.brunch} variant="ghost">Weekend Brunch</Button>
      <Button href={venue.routes.contact} variant="ghost">Contact Us</Button>
    </div>
  </section>
</Layout>
