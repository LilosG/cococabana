---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SplitSection from '../components/SplitSection.astro';
import FullBleedBanner from '../components/FullBleedBanner.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import FeatureTagList from '../components/FeatureTagList.astro';
import { venue } from '../data/venue';
import { venuePage } from '../lib/cms';
import { getPhoto } from '../utils/images';
import { resolveFocalProps } from '../config/image-focal';

const statsHtml = (stats: Array<{ value: string; label: string }>) =>
  stats
    .map(
      (stat) =>
        `<div class="px-5 py-8 text-center"> <p class="accent-text text-2xl text-brand-pink mb-1">${stat.value}</p> <p class="uppercase tracking-stat text-xs text-brand-cream/50">${stat.label}</p> </div>`,
    )
    .join(' ');
const galleryImages = venuePage.gallery.images.map((image) => ({
  ...image,
  resolved: image.src?.trim() ? getPhoto(image.src) : undefined,
}));
---

<Layout
  transparentNav={true}
  title={venuePage.seoTitle}
  description={venuePage.seoDescription}
>
  <PageHero
    image={venuePage.heroImage.src?.trim() ? getPhoto(venuePage.heroImage.src) : undefined}
    imageAlt={venuePage.heroImage.alt}
    {...resolveFocalProps(venuePage.heroImage)}
  >
    <Eyebrow tone="dark">{venuePage.heroEyebrow}</Eyebrow>
    <h1 class="font-display leading-ultra text-hero uppercase mb-6" set:html={venuePage.heroTitle.replace(/\n/g, '<br />')} />
    <p class="text-brand-cream/80 leading-relaxed max-w-xl mb-8">{venuePage.heroText}</p>
    <div class="flex flex-wrap gap-4">
      <Button href={venue.reservationsUrl} variant="primary" external>{venuePage.primaryCtaText}</Button>
      <Button href={venue.routes.privateEvents} variant="ghost">{venuePage.secondaryCtaText}</Button>
    </div>
  </PageHero>

  <!-- STATS STRIP -->
  <section class="bg-brand-charcoal text-brand-cream">
    <div class="max-w-5xl mx-auto grid grid-cols-2 sm:grid-cols-4 divide-x divide-y sm:divide-y-0 divide-brand-cream/10">
      <Fragment set:html={statsHtml(venuePage.stats)} />
    </div>
  </section>

  <!-- THE ROOFTOP -->
  <SplitSection
    image={venuePage.sections[0].image?.trim() ? getPhoto(venuePage.sections[0].image) : undefined}
    imageAlt={venuePage.sections[0].imageAlt}
    {...resolveFocalProps(venuePage.sections[0])}
    imageLeft={true}
    tone="light"
  >
    <Eyebrow>{venuePage.sections[0].eyebrow}</Eyebrow>
    <h2 class="font-display text-section-xl leading-display uppercase text-brand-charcoal mb-4">{venuePage.sections[0].title}</h2>
    <p class="accent-text text-accent-xl text-brand-pink mb-6">{venuePage.sections[0].accent}</p>
    <p class="text-brand-charcoal/70 leading-relaxed mb-8">{venuePage.sections[0].text}</p>
    <FeatureTagList tags={venuePage.sections[0].tags!} />
  </SplitSection>

  <!-- THE CABANA — full-bleed banner -->
  <FullBleedBanner
    image={venuePage.sections[1].image?.trim() ? getPhoto(venuePage.sections[1].image) : undefined}
    imageAlt={venuePage.sections[1].imageAlt}
    {...resolveFocalProps(venuePage.sections[1])}
    minHeight={venuePage.sections[1].minHeight}
  >
    <Eyebrow tone="dark">{venuePage.sections[1].eyebrow}</Eyebrow>
    <h2 class="font-display leading-display text-section-xl uppercase mb-2">{venuePage.sections[1].title}</h2>
    <p class="accent-text text-accent-xl text-brand-pink mb-6">{venuePage.sections[1].accent}</p>
    <p class="text-brand-cream/80 leading-relaxed mb-8" set:html={venuePage.sections[1].text} />
    <div class="flex flex-wrap gap-4">
      <Button href={venue.reservationsUrl} variant="primary" external>{venuePage.sections[1].ctaText}</Button>
    </div>
  </FullBleedBanner>

  <!-- THE VIEW -->
  <SplitSection
    image={venuePage.sections[2].image?.trim() ? getPhoto(venuePage.sections[2].image) : undefined}
    imageAlt={venuePage.sections[2].imageAlt}
    {...resolveFocalProps(venuePage.sections[2])}
    imageLeft={false}
    tone="dark"
  >
    <Eyebrow tone="dark">{venuePage.sections[2].eyebrow}</Eyebrow>
    <h2 class="font-display text-section-xl leading-display uppercase text-brand-cream mb-4">{venuePage.sections[2].title}</h2>
    <p class="accent-text text-accent-xl text-brand-pink mb-6">{venuePage.sections[2].accent}</p>
    <p class="text-brand-cream/70 leading-relaxed mb-8">{venuePage.sections[2].text}</p>
    <FeatureTagList tags={venuePage.sections[2].tags!} />
  </SplitSection>

  <!-- LIVE MUSIC — full-bleed banner -->
  <FullBleedBanner
    image={venuePage.sections[3].image?.trim() ? getPhoto(venuePage.sections[3].image) : undefined}
    imageAlt={venuePage.sections[3].imageAlt}
    {...resolveFocalProps(venuePage.sections[3])}
    minHeight={venuePage.sections[3].minHeight}
  >
    <Eyebrow tone="dark">{venuePage.sections[3].eyebrow}</Eyebrow>
    <h2 class="font-display leading-display text-section-xl uppercase mb-2" set:html={venuePage.sections[3].title} />
    <p class="accent-text text-accent-xl text-brand-pink mb-6">{venuePage.sections[3].accent}</p>
    <p class="text-brand-cream/80 leading-relaxed mb-8">{venuePage.sections[3].text}</p>
    <Button href={venue.reservationsUrl} variant="primary" external>{venuePage.sections[3].ctaText}</Button>
  </FullBleedBanner>

  <!-- DETAILS MOSAIC -->
  <section class="bg-brand-cream px-6 sm:px-8 lg:px-12 py-20 sm:py-28">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <Eyebrow align="center">{venuePage.gallery.eyebrow}</Eyebrow>
      <h2 class="font-display text-section-xl leading-display uppercase text-brand-charcoal">{venuePage.gallery.title}</h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 max-w-5xl mx-auto">
      {galleryImages.slice(0, 6).map((image) => (
        <div class="overflow-hidden aspect-square">
          {image.resolved && (
            <Image src={image.resolved} alt={image.alt} layout="constrained" sizes="(min-width: 1024px) 330px, (min-width: 768px) 33vw, 50vw" loading="lazy" class={image.position} />
          )}
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-brand-charcoal px-6 sm:px-8 lg:px-12 py-16 sm:py-20 text-center">
    <Eyebrow align="center" tone="dark">{venuePage.finalCta.eyebrow}</Eyebrow>
    <h2 class="font-display text-section-xl leading-display uppercase text-brand-cream mb-6">{venuePage.finalCta.title}</h2>
    <p class="text-brand-cream/60 mb-8" set:html={venuePage.finalCta.detail} />
    <div class="flex flex-wrap gap-4 justify-center">
      <Button href={venue.reservationsUrl} variant="primary" external>{venuePage.finalCta.primaryCtaText}</Button>
      <Button href={venue.routes.brunch} variant="ghost">{venuePage.finalCta.secondaryCtaText}</Button>
      <Button href={venue.routes.privateEvents} variant="ghost">{venuePage.finalCta.tertiaryCtaText}</Button>
    </div>
  </section>
</Layout>
