---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import FeatureTagList from '../components/FeatureTagList.astro';
import { venue } from '../data/venue';
---

<Layout
  transparentNav={true}
  title={`The Venue | ${venue.fullName}`}
  description={`The rooftop, the cabana, and the live music program at ${venue.name} — ${venue.hotel}, ${venue.address.city}, ${venue.address.state}.`}
>
  <PageHero
    image="/photos/venue-aerial-sign.jpg"
    imageAlt="Coco Cabana rooftop bar aerial view — COCOCABANA sign on The Brick Hotel in Downtown Oceanside"
  >
    <Eyebrow tone="dark">{venue.address.city}, {venue.address.state} &middot; {venue.hotel}</Eyebrow>
    <h1 class="font-display leading-ultra text-hero uppercase mb-6">
      The Rooftop.<br />The Cabana.
    </h1>
    <p class="text-brand-cream/80 leading-relaxed max-w-xl mb-8">
      One space above {venue.hotel}, built around its own identity — the open-air rooftop,
      the cushioned cabana seating, and the live music that brings it together after dark.
    </p>
    <div class="flex flex-wrap gap-4">
      <Button href={venue.reservationsUrl} variant="primary" external>Reserve a Table</Button>
      <Button href={venue.routes.privateEvents} variant="ghost">Private Events</Button>
    </div>
  </PageHero>

  <!-- THE CABANA -->
  <section id="cabana" class="bg-brand-charcoal px-6 sm:px-8 lg:px-12 py-20 sm:py-28">
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="md:order-2">
        <img
          src="/photos/lounge-tile-cushions.jpg"
          alt="Coco Cabana lounge seating with tile wall and cushioned daybeds"
          class="w-full aspect-[4/3] object-cover"
        />
      </div>
      <div class="md:order-1">
        <Eyebrow tone="dark">The Cabana</Eyebrow>
        <h2 class="font-display text-section-xl leading-display uppercase text-brand-cream mb-4">Lounge Seating</h2>
        <p class="text-brand-cream/70 leading-relaxed mb-6">
          The cabana's signature lounge seating is designed for settling in — rattan pendants
          overhead, geometric tile walls, pink daybeds, and unobstructed views of the Oceanside
          skyline.
        </p>
        <FeatureTagList tags={['Cushioned Daybeds', 'Tile Bar Wall', 'Rooftop Views']} />
      </div>
    </div>
  </section>

  <!-- LIVE MUSIC -->
  <section class="bg-brand-cream px-6 sm:px-8 lg:px-12 py-20 sm:py-28">
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 lg:gap-16 items-center">
      <img
        src="/photos/live-music-dj.jpg"
        alt="DJ set at Coco Cabana rooftop with crowd"
        class="w-full aspect-[4/3] object-cover object-[center_30%]"
      />
      <div>
        <Eyebrow>After Dark</Eyebrow>
        <h2 class="font-display text-section-xl leading-display uppercase text-brand-charcoal mb-4">Live Music &amp; Events</h2>
        <p class="text-brand-charcoal/70 leading-relaxed mb-6">
          Live DJ sets every Friday and Saturday night. The rooftop transforms after dark —
          cocktails, open air, and the Oceanside skyline as your backdrop.
        </p>
        <FeatureTagList tags={['DJ Fri & Sat', 'Every Weekend', 'Rooftop']} />
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="bg-brand-charcoal px-6 sm:px-8 lg:px-12 py-16 sm:py-20 text-center">
    <Eyebrow align="center" tone="dark">Come See It</Eyebrow>
    <h2 class="font-display text-section-xl leading-display uppercase text-brand-cream mb-6">
      {venue.name} Awaits
    </h2>
    <p class="text-brand-cream/60 mb-8">
      {venue.hotel}, {venue.address.city}, {venue.address.state} &middot; {venue.hours.shortSummary}
    </p>
    <div class="flex flex-wrap gap-4 justify-center">
      <Button href={venue.reservationsUrl} variant="primary" external>Reserve a Table</Button>
      <Button href={venue.routes.privateEvents} variant="ghost">Plan a Private Event</Button>
    </div>
  </section>
</Layout>
