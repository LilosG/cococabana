---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import InfoStrip from '../components/InfoStrip.astro';
import SplitSection from '../components/SplitSection.astro';
import FullBleedBanner from '../components/FullBleedBanner.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import MenuCard from '../components/MenuCard.astro';
import { venue } from '../data/venue';
import { menuSections } from '../data/menu';
import { getPhoto } from '../utils/images';
import { menuPage } from '../lib/cms';
import { resolveFocalProps } from '../config/image-focal';

const menuSchema = {
  "@type": "Menu",
  "@id": "https://cococabanaoside.com/menu#menu",
  "name": `${venue.fullName} Menu`,
  "url": "https://cococabanaoside.com/menu",
  "hasMenuSection": menuSections.map(section => ({
    "@type": "MenuSection",
    "name": section.heading,
    "hasMenuItem": section.items
      .filter(item => item.name)
      .map(item => ({
        "@type": "MenuItem",
        "name": item.name,
        ...(item.description ? { "description": item.description } : {}),
      })),
  })),
};

const foodSection = menuSections.find(s => s.id === 'food')!;
const cocktailsSection = menuSections.find(s => s.id === 'cocktails')!;
const introImage = menuPage.intro.image?.trim() ? getPhoto(menuPage.intro.image) : undefined;
const rooftopPromoImage = menuPage.rooftopPromo.image?.trim() ? getPhoto(menuPage.rooftopPromo.image) : undefined;
const cocktailPromoImage = menuPage.cocktailPromo.image?.trim() ? getPhoto(menuPage.cocktailPromo.image) : undefined;
const menuInfoItems = [
  {
    label: menuPage.infoStrip.locationLabel,
    value: venue.address.neighborhood,
    detail: `${menuPage.infoStrip.locationDetailPrefix} ${venue.hotel}`,
  },
  {
    label: menuPage.infoStrip.brunchLabel,
    value: venue.brunch.days,
    detail: venue.brunch.hours,
  },
  menuPage.infoStrip.kitchen,
  menuPage.infoStrip.setting,
];
---

<Layout
  transparentNav={true}
  title={menuPage.seoTitle}
  description={menuPage.seoDescription}
  extraGraph={[menuSchema]}
>
  <PageHero
    image={menuPage.heroImage.src?.trim() ? getPhoto(menuPage.heroImage.src) : undefined}
    imageAlt={menuPage.heroImage.alt}
    {...resolveFocalProps(menuPage.heroImage)}
    heightClass="min-h-[62svh] sm:min-h-[68svh]"
  >
    <Eyebrow tone="dark">{menuPage.heroEyebrow}</Eyebrow>
    <p class="font-display leading-ultra text-hero uppercase mb-4">{menuPage.heroTitle}</p>
    <p class="text-brand-cream/80 leading-relaxed max-w-xl mb-8">{menuPage.heroText}</p>
    <Button href={venue.orderUrl} variant="primary" external>{menuPage.primaryCtaText}</Button>
  </PageHero>

  <InfoStrip items={menuInfoItems} />

  <!-- MENU INTRODUCTION -->
  <SplitSection
    image={introImage}
    imageAlt={menuPage.intro.imageAlt}
    {...resolveFocalProps(menuPage.intro)}
    tone="light"
    minHeight="min-h-[600px] md:min-h-[660px]"
  >
    <Eyebrow>{menuPage.intro.eyebrow}</Eyebrow>
    <h1 class="font-display text-section-xl leading-display uppercase text-brand-charcoal mb-4">{menuPage.intro.title}</h1>
    <p class="accent-text text-accent-xl text-brand-pink mb-6">{menuPage.intro.accent}</p>
    <div class="space-y-4 text-brand-charcoal/70 leading-relaxed">
      {menuPage.intro.text.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </SplitSection>

  <!-- ROOFTOP CHAPTER -->
  <FullBleedBanner
    image={rooftopPromoImage}
    imageAlt={menuPage.rooftopPromo.imageAlt}
    {...resolveFocalProps(menuPage.rooftopPromo)}
  >
    <Eyebrow tone="dark">{menuPage.rooftopPromo.eyebrow}</Eyebrow>
    <h2 class="font-display leading-display text-section-xl uppercase mb-2">{menuPage.rooftopPromo.title}</h2>
    <p class="accent-text text-accent-xl text-brand-pink mb-6">{menuPage.rooftopPromo.accent}</p>
    <p class="text-brand-cream/80 leading-relaxed">{menuPage.rooftopPromo.text}</p>
  </FullBleedBanner>

  <!-- FOOD -->
  <section id="food" class="bg-brand-cream px-6 sm:px-8 lg:px-12 py-20 sm:py-28">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <Eyebrow align="center">{menuPage.sections[0].eyebrow}</Eyebrow>
      <h2 class="font-display text-section-xl leading-display uppercase text-brand-charcoal mb-4">{menuPage.sections[0].title}</h2>
      <p class="text-brand-charcoal/60 leading-relaxed">{menuPage.sections[0].text}</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-6 max-w-5xl mx-auto mb-10">
      {foodSection.items.map(item => (
        <MenuCard
          name={item.name}
          description={item.description}
          image={item.image?.trim() ? getPhoto(item.image) : undefined}
          imageAlt={item.imageAlt}
          imagePosition={item.imagePosition}
          category={foodSection.category}
          tone={foodSection.tone}
        />
      ))}
    </div>
  </section>

  <!-- COCKTAIL CHAPTER -->
  <FullBleedBanner
    image={cocktailPromoImage}
    imageAlt={menuPage.cocktailPromo.imageAlt}
    {...resolveFocalProps(menuPage.cocktailPromo)}
  >
    <Eyebrow tone="dark">{menuPage.cocktailPromo.eyebrow}</Eyebrow>
    <h2 class="font-display leading-display text-section-xl uppercase mb-2">{menuPage.cocktailPromo.title}</h2>
    <p class="accent-text text-accent-xl text-brand-pink mb-6">{menuPage.cocktailPromo.accent}</p>
    <p class="text-brand-cream/80 leading-relaxed mb-8">{menuPage.cocktailPromo.text}</p>
    <Button href={venue.reservationsUrl} variant="primary" external>{menuPage.cocktailPromo.ctaText}</Button>
  </FullBleedBanner>

  <!-- COCKTAILS -->
  <section id="cocktails" class="bg-brand-charcoal px-6 sm:px-8 lg:px-12 py-20 sm:py-28">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <Eyebrow align="center" tone="dark">{menuPage.sections[1].eyebrow}</Eyebrow>
      <h2 class="font-display text-section-xl leading-display uppercase text-brand-cream mb-4">{menuPage.sections[1].title}</h2>
      <p class="text-brand-cream/60 leading-relaxed">{menuPage.sections[1].text}</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-5xl mx-auto mb-10">
      {cocktailsSection.items.map(item => (
        <MenuCard
          name={item.name}
          description={item.description}
          image={item.image?.trim() ? getPhoto(item.image) : undefined}
          imageAlt={item.imageAlt}
          imagePosition={item.imagePosition}
          category={cocktailsSection.category}
          imageSizes="(min-width: 1024px) 240px, (min-width: 768px) 25vw, 50vw"
          tone={cocktailsSection.tone}
        />
      ))}
    </div>
  </section>

  <!-- BRUNCH CALLOUT BANNER -->
  <FullBleedBanner
    image={menuPage.brunchPromo.image?.trim() ? getPhoto(menuPage.brunchPromo.image) : undefined}
    imageAlt={menuPage.brunchPromo.imageAlt}
    {...resolveFocalProps(menuPage.brunchPromo)}
    minHeight={menuPage.brunchPromo.minHeight}
  >
    <Eyebrow tone="dark">{menuPage.brunchPromo.eyebrow}</Eyebrow>
    <h2 class="font-display leading-display text-section-xl uppercase mb-2" set:html={menuPage.brunchPromo.title} />
    <p class="accent-text text-accent-xl text-brand-pink mb-6">{venue.brunch.days}</p>
    <p class="text-brand-cream/80 leading-relaxed mb-2">{venue.brunch.hours}</p>
    <p class="text-brand-cream/60 text-sm mb-8">{venue.brunch.highlight}</p>
    <div class="flex flex-wrap gap-4">
      <Button href={venue.routes.brunch} variant="primary">{menuPage.brunchPromo.primaryCtaText}</Button>
      <Button href={venue.reservationsUrl} variant="ghost" external>{menuPage.brunchPromo.secondaryCtaText}</Button>
    </div>
  </FullBleedBanner>

  <!-- RESERVE CTA -->
  <section class="bg-brand-cream px-6 sm:px-8 lg:px-12 py-16 sm:py-20 text-center">
    <h2 class="font-display text-section-xl leading-display uppercase text-brand-charcoal mb-2">{menuPage.reserve.title}</h2>
    <p class="accent-text text-accent-xl text-brand-pink mb-8">{menuPage.reserve.accent}</p>
    <div class="flex flex-wrap gap-4 justify-center">
      <Button href={venue.reservationsUrl} variant="primary" external>{menuPage.reserve.primaryCtaText}</Button>
      <Button href={venue.routes.venue} variant="secondary">{menuPage.reserve.secondaryCtaText}</Button>
    </div>
  </section>
</Layout>
