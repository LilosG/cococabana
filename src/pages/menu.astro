---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import MenuCard from '../components/MenuCard.astro';
import { venue } from '../data/venue';
---

<Layout
  transparentNav={true}
  title={`Menu | ${venue.fullName}`}
  description={`Food and cocktails at ${venue.name} — ${venue.hotel}, ${venue.address.city}, ${venue.address.state}.`}
>
  <PageHero
    image="/photos/menu-flamingo-hero.jpg"
    imageAlt="Coco Cabana signature copper flamingo cocktail vessel with rattan pendants and Oceanside rooftop in background"
    imagePosition="object-[center_30%]"
  >
    <Eyebrow tone="dark">{venue.address.city}, {venue.address.state}</Eyebrow>
    <h1 class="font-display leading-ultra text-hero uppercase mb-6">The Menu</h1>
    <p class="text-brand-cream/80 leading-relaxed max-w-xl mb-8">
      Rooftop plates and a craft cocktail program built for {venue.address.city}'s coastline.
    </p>
    <Button href={venue.reservationsUrl} variant="primary" external>Reserve a Table</Button>
  </PageHero>

  <!-- FOOD -->
  <section id="food" class="bg-brand-cream px-6 sm:px-8 lg:px-12 py-20 sm:py-28">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <Eyebrow align="center">The Kitchen</Eyebrow>
      <h2 class="font-display text-section-xl leading-display uppercase text-brand-charcoal mb-4">Food</h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      <MenuCard image="/photos/food/wings.jpg" imageAlt="Fried chicken wings with chili and herb garnish" category="food" />
      <MenuCard name="Spicy Chicken Bowl" image="/photos/food/spicy-chicken-bowl.jpg" imageAlt="Spicy chicken bowl with rice, broccolini, and pico" imagePosition="object-[center_80%]" category="food" />
      <MenuCard name="Hawaiian Cubano" image="/photos/food/hawaiian-cubano.jpg" imageAlt="Hawaiian Cubano sandwich with fries" imagePosition="object-[center_75%]" category="food" />
      <MenuCard name="Coconut Shrimp" image="/photos/food/coconut-shrimp-v2.jpg" imageAlt="Coconut shrimp with dipping sauce" category="food" />
      <MenuCard name="Chicken Sando" image="/photos/food/chicken-sando.jpg" imageAlt="Crispy chicken sandwich with slaw and fries" imagePosition="object-[center_75%]" category="food" />
      <MenuCard name="Miss B's Burger" image="/photos/food/miss-bs-burger.jpg" imageAlt="Miss B's Burger with cheese, lettuce, tomato, and fries" imagePosition="object-[center_78%]" category="food" />
    </div>
  </section>

  <!-- COCKTAILS -->
  <section id="cocktails" class="bg-brand-charcoal px-6 sm:px-8 lg:px-12 py-20 sm:py-28">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <Eyebrow align="center" tone="dark">The Bar</Eyebrow>
      <h2 class="font-display text-section-xl leading-display uppercase text-brand-cream mb-4">Cocktails</h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-5xl mx-auto">
      <MenuCard name="Caribe Welcome" description="House rum blend, coconut water, apricot brandy, coconut cream, fresh lime" image="/photos/drinks/caribe-welcome.jpg" imageAlt="Caribe Welcome cocktail served in a coconut with orchid garnish" category="drinks" tone="dark" />
      <MenuCard name="Swedish Bikini Team" description="House rum blend, strawberry, cucumber, coconut water, lemon" image="/photos/drinks/swedish-bikini-team.jpg" imageAlt="Swedish Bikini Team cocktail with cucumber ribbon and strawberry garnish" category="drinks" tone="dark" />
      <MenuCard name="Havana Good Time" image="/photos/drinks/havana-good-time.jpg" imageAlt="Havana Good Time cocktail served in a copper flamingo vessel" imagePosition="object-[center_85%]" category="drinks" tone="dark" />
      <MenuCard name="Miami Pound Machine" description="Blanco tequila, passionfruit, bitters" image="/photos/drinks/miami-pound-machine.jpg" imageAlt="Miami Pound Machine cocktail with banana leaf and lime wheel garnish" imagePosition="object-[25%_center]" category="drinks" tone="dark" />
    </div>
  </section>

  <section class="bg-brand-cream px-6 sm:px-8 lg:px-12 py-16 sm:py-20 text-center">
    <h2 class="font-display text-section-xl leading-display uppercase text-brand-charcoal mb-2">Reserve</h2>
    <p class="accent-text text-accent-xl text-brand-pink mb-8">Your Table</p>
    <Button href={venue.reservationsUrl} variant="primary" external>Reserve Now</Button>
  </section>
</Layout>
