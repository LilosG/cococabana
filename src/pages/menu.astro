---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import FullBleedBanner from '../components/FullBleedBanner.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import MenuCard from '../components/MenuCard.astro';
import { venue } from '../data/venue';
import { menuSections } from '../data/menu';
import { getPhoto } from '../utils/images';
import { menuPage } from '../lib/cms';

import menuHeroImg from '../assets/photos/menu-flamingo-hero.jpg';
import brunchMimosasBanner from '../assets/photos/brunch-mimosas-banner.jpg';

const menuSchema = {
  "@type": "Menu",
  "@id": "https://cococabanaoside.com/menu#menu",
  "name": `${venue.fullName} Menu`,
  "url": "https://cococabanaoside.com/menu",
  "hasMenuSection": menuSections.map(section => ({
    "@type": "MenuSection",
    "name": section.heading,
    "hasMenuItem": section.items
      .filter(item => item.name)
      .map(item => ({
        "@type": "MenuItem",
        "name": item.name,
        ...(item.description ? { "description": item.description } : {}),
      })),
  })),
};

const foodSection = menuSections.find(s => s.id === 'food')!;
const cocktailsSection = menuSections.find(s => s.id === 'cocktails')!;
---

<Layout
  transparentNav={true}
  title={menuPage.seoTitle}
  description={menuPage.seoDescription}
  extraGraph={[menuSchema]}
>
  <PageHero
    image={menuHeroImg}
    imageAlt="Coco Cabana signature copper flamingo cocktail vessel with rattan pendants and Oceanside rooftop"
    imagePosition="object-bottom"
  >
    <Eyebrow tone="dark">{menuPage.heroEyebrow}</Eyebrow>
    <h1 class="font-display leading-ultra text-hero uppercase mb-6">{menuPage.heroTitle}</h1>
    <p class="text-brand-cream/80 leading-relaxed max-w-xl mb-8">{menuPage.heroText}</p>
    <Button href={venue.reservationsUrl} variant="primary" external>{menuPage.primaryCtaText}</Button>
  </PageHero>

  <!-- FOOD -->
  <section id="food" class="bg-brand-cream px-6 sm:px-8 lg:px-12 py-20 sm:py-28">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <Eyebrow align="center">The Kitchen</Eyebrow>
      <h2 class="font-display text-section-xl leading-display uppercase text-brand-charcoal mb-4">Food</h2>
      <p class="text-brand-charcoal/60 leading-relaxed">
        Rooftop plates built to share — Caribbean-influenced and made for the open air.
      </p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-6 max-w-5xl mx-auto mb-10">
      {foodSection.items.map(item => (
        <MenuCard
          name={item.name}
          description={item.description}
          image={getPhoto(item.image)}
          imageAlt={item.imageAlt}
          imagePosition={item.imagePosition}
          category={foodSection.category}
          tone={foodSection.tone}
        />
      ))}
    </div>
  </section>

  <!-- COCKTAILS -->
  <section id="cocktails" class="bg-brand-charcoal px-6 sm:px-8 lg:px-12 py-20 sm:py-28">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <Eyebrow align="center" tone="dark">The Bar</Eyebrow>
      <h2 class="font-display text-section-xl leading-display uppercase text-brand-cream mb-4">Cocktails</h2>
      <p class="text-brand-cream/60 leading-relaxed">
        Caribbean-inspired cocktails crafted from scratch — built for a rooftop above the Pacific.
      </p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-5xl mx-auto mb-10">
      {cocktailsSection.items.map(item => (
        <MenuCard
          name={item.name}
          description={item.description}
          image={getPhoto(item.image)}
          imageAlt={item.imageAlt}
          imagePosition={item.imagePosition}
          category={cocktailsSection.category}
          tone={cocktailsSection.tone}
        />
      ))}
    </div>
    <div class="text-center">
      <Button href={venue.reservationsUrl} variant="ghost" external>Reserve a Table</Button>
    </div>
  </section>

  <!-- BRUNCH CALLOUT BANNER -->
  <FullBleedBanner
    image={brunchMimosasBanner}
    imageAlt="Coco Cabana bottomless mimosas — Campo Viejo cava flights with copper flamingo on marble table"
    imagePosition="object-center"
    minHeight="min-h-[560px] sm:min-h-[620px]"
  >
    <Eyebrow tone="dark">Weekend Brunch</Eyebrow>
    <h2 class="font-display leading-display text-section-xl uppercase mb-2">
      Brunch on<br />the Rooftop
    </h2>
    <p class="accent-text text-accent-xl text-brand-pink mb-6">{venue.brunch.days}</p>
    <p class="text-brand-cream/80 leading-relaxed mb-2">{venue.brunch.hours}</p>
    <p class="text-brand-cream/60 text-sm mb-8">{venue.brunch.highlight}</p>
    <div class="flex flex-wrap gap-4">
      <Button href={venue.routes.brunch} variant="primary">View Brunch Menu</Button>
      <Button href={venue.reservationsUrl} variant="ghost" external>Reserve</Button>
    </div>
  </FullBleedBanner>

  <!-- RESERVE CTA -->
  <section class="bg-brand-cream px-6 sm:px-8 lg:px-12 py-16 sm:py-20 text-center">
    <h2 class="font-display text-section-xl leading-display uppercase text-brand-charcoal mb-2">Reserve</h2>
    <p class="accent-text text-accent-xl text-brand-pink mb-8">Your Table</p>
    <div class="flex flex-wrap gap-4 justify-center">
      <Button href={venue.reservationsUrl} variant="primary" external>Reserve Now</Button>
      <Button href={venue.routes.venue} variant="secondary">See the Space</Button>
    </div>
  </section>
</Layout>
