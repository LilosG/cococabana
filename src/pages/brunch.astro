---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SplitSection from '../components/SplitSection.astro';
import FullBleedBanner from '../components/FullBleedBanner.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import MenuCard from '../components/MenuCard.astro';
import { venue } from '../data/venue';
import { brunchFood, brunchDrinks } from '../data/brunch';
---

<Layout
  title={`Brunch | ${venue.fullName} | ${venue.address.city}, ${venue.address.state}`}
  description={`Weekend brunch at ${venue.name} — ${venue.brunch.days}, ${venue.brunch.hours}. Rooftop dining above Downtown ${venue.address.city} at ${venue.hotel}.`}
  transparentNav={true}
>
  <PageHero
    image="/photos/brunch-hero.jpg"
    imageAlt="Coco Cabana weekend brunch spread — colorful plates, eggs, French toast on marble table"
    imagePosition="object-top"
  >
    <Eyebrow tone="dark">Weekend Brunch</Eyebrow>
    <h1 class="font-display leading-ultra text-hero uppercase mb-2">Brunch</h1>
    <p class="accent-text text-accent-xl text-brand-pink mb-4">on the Rooftop</p>
    <p class="text-brand-cream/70 text-sm uppercase tracking-label mb-8">
      {venue.brunch.days} &middot; {venue.brunch.hours}
    </p>
    <div class="flex flex-wrap gap-4">
      <Button href={venue.reservationsUrl} variant="primary" external>Reserve a Table</Button>
      <Button href="#brunch-menu" variant="ghost">View the Menu</Button>
    </div>
  </PageHero>

  <!-- INFO STRIP -->
  <section class="bg-brand-charcoal text-brand-cream">
    <div class="max-w-4xl mx-auto grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-brand-cream/10">
      <div class="px-6 py-8 text-center">
        <p class="accent-text text-2xl text-brand-pink mb-1">{venue.brunch.days}</p>
        <p class="uppercase tracking-stat text-xs text-brand-cream/50">{venue.brunch.hours}</p>
      </div>
      <div class="px-6 py-8 text-center">
        <p class="accent-text text-2xl text-brand-pink mb-1">Bottomless Mimosas</p>
        <p class="uppercase tracking-stat text-xs text-brand-cream/50">2-Hour Limit · While You Dine</p>
      </div>
      <div class="px-6 py-8 text-center">
        <p class="accent-text text-2xl text-brand-pink mb-1">Rooftop</p>
        <p class="uppercase tracking-stat text-xs text-brand-cream/50">{venue.hotel}, {venue.address.city}</p>
      </div>
    </div>
  </section>

  <!-- BRUNCH MENU -->
  <section id="brunch-menu" class="bg-brand-cream px-6 sm:px-8 lg:px-12 py-20 sm:py-28">
    <div class="max-w-2xl mx-auto text-center mb-14">
      <Eyebrow align="center">The Menu</Eyebrow>
      <h2 class="font-display text-section-xl leading-display uppercase text-brand-charcoal mb-4">Brunch Menu</h2>
      <p class="text-brand-charcoal/60 leading-relaxed">
        {venue.brunch.days} &middot; {venue.brunch.hours}
      </p>
    </div>

    <!-- Food -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-6 max-w-5xl mx-auto mb-20">
      {brunchFood.map(item => (
        <MenuCard name={item.name} image={item.image} imageAlt={item.imageAlt} imagePosition={item.imagePosition} category="food" />
      ))}
    </div>

    <!-- Drinks -->
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-10">
        <Eyebrow align="center">The Bar</Eyebrow>
        <h3 class="font-display text-2xl leading-display uppercase text-brand-charcoal">Bottomless Mimosas</h3>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-3xl mx-auto">
        {brunchDrinks.map(item => (
          <MenuCard name={item.name} image={item.image} imageAlt={item.imageAlt} description={item.description} category="drinks" />
        ))}
      </div>
    </div>
  </section>

  <!-- MIMOSA BANNER -->
  <FullBleedBanner
    image="/photos/brunch-mimosas-banner.jpg"
    imageAlt="Coco Cabana bottomless mimosas — Campo Viejo cava flights with copper flamingo on marble table"
    imagePosition="object-center"
    minHeight="min-h-[560px] sm:min-h-[620px]"
  >
    <Eyebrow tone="dark">Bottomless Mimosas</Eyebrow>
    <h2 class="font-display leading-display text-section-xl uppercase mb-2">
      Campo Viejo<br />Cava
    </h2>
    <p class="accent-text text-accent-xl text-brand-pink mb-6">2-Hour Bottomless</p>
    <p class="text-brand-cream/80 leading-relaxed mb-8">
      Classic, Tropical &amp; Citrus — bottomless for 2 hours while you dine. Available every {venue.brunch.days} from {venue.brunch.hours}.
    </p>
    <Button href={venue.reservationsUrl} variant="primary" external>Reserve Your Table</Button>
  </FullBleedBanner>

  <!-- ROOFTOP SPLIT -->
  <SplitSection
    image="/photos/brunch-rooftop-banner.jpg"
    imageAlt="Coco Cabana rooftop brunch setup with disco balls, mimosas, and palms"
    imageLeft={true}
    tone="dark"
  >
    <Eyebrow tone="dark">The Setting</Eyebrow>
    <h2 class="font-display text-section-xl leading-display uppercase text-brand-cream mb-4">Brunch Above Oceanside</h2>
    <p class="accent-text text-accent-xl text-brand-pink mb-6">Every Weekend</p>
    <p class="text-brand-cream/70 leading-relaxed mb-8">
      There's no better setting for a weekend brunch than four stories above Downtown Oceanside. Disco balls, palm trees, and bottomless mimosas — the rooftop is all yours on {venue.brunch.days}.
    </p>
    <Button href={venue.reservationsUrl} variant="primary" external>Reserve Now</Button>
  </SplitSection>

  <!-- RESERVE CTA -->
  <section class="bg-brand-charcoal px-6 sm:px-8 lg:px-12 py-16 sm:py-20 text-center">
    <h2 class="font-display text-section-xl leading-display uppercase text-brand-cream mb-2">Reserve</h2>
    <p class="accent-text text-accent-xl text-brand-pink mb-6">Your Brunch Table</p>
    <p class="text-brand-cream/60 mb-8">{venue.brunch.days} &middot; {venue.brunch.hours} &middot; {venue.address.street}, {venue.address.city}</p>
    <div class="flex flex-wrap gap-4 justify-center">
      <Button href={venue.reservationsUrl} variant="primary" external>Reserve Now</Button>
      <Button href={venue.routes.menu} variant="ghost">View Full Menu</Button>
    </div>
  </section>
</Layout>
