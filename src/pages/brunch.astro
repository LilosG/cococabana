---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import MenuCard from '../components/MenuCard.astro';
import { venue } from '../data/venue';
---

<Layout
  title={`Brunch | ${venue.fullName} | ${venue.address.city}, ${venue.address.state}`}
  description={`Weekend brunch at ${venue.name} — ${venue.brunch.days}, ${venue.brunch.hours}. ${venue.brunch.highlight}. Rooftop dining above Downtown Oceanside at ${venue.hotel}.`}
  transparentNav={true}
>
  <PageHero
    image="/photos/brunch-hero.jpg"
    imageAlt="Coco Cabana weekend brunch spread — colorful plates, eggs, French toast, mimosas on marble table"
    imagePosition="object-top"
    heightClass="min-h-[80vh]"
  >
    <Eyebrow tone="dark">Weekend Brunch</Eyebrow>
    <h1 class="font-display leading-ultra text-hero uppercase mb-2">Brunch</h1>
    <p class="accent-text text-accent-xl text-brand-pink mb-4">on the Rooftop</p>
    <p class="text-brand-cream/70 text-sm uppercase tracking-label mb-8">
      {venue.brunch.days} &middot; {venue.brunch.hours}
    </p>
    <div class="flex flex-wrap gap-4">
      <Button href={venue.reservationsUrl} variant="primary" external>Reserve a Table</Button>
      <Button href="#brunch-menu" variant="ghost">View the Menu</Button>
    </div>
  </PageHero>

  <!-- INFO STRIP -->
  <section class="bg-brand-charcoal text-brand-cream">
    <div class="max-w-4xl mx-auto grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-brand-cream/10">
      <div class="px-6 py-8 text-center">
        <p class="accent-text text-2xl text-brand-pink mb-1">{venue.brunch.days}</p>
        <p class="uppercase tracking-stat text-xs text-brand-cream/50">{venue.brunch.hours}</p>
      </div>
      <div class="px-6 py-8 text-center">
        <p class="accent-text text-2xl text-brand-pink mb-1">Bottomless Mimosas</p>
        <p class="uppercase tracking-stat text-xs text-brand-cream/50">2-Hour Limit · While You Dine</p>
      </div>
      <div class="px-6 py-8 text-center">
        <p class="accent-text text-2xl text-brand-pink mb-1">Rooftop</p>
        <p class="uppercase tracking-stat text-xs text-brand-cream/50">{venue.hotel}, {venue.address.city}</p>
      </div>
    </div>
  </section>

  <!-- BRUNCH MENU -->
  <section id="brunch-menu" class="bg-brand-cream px-6 sm:px-8 lg:px-12 py-20 sm:py-28">
    <div class="max-w-2xl mx-auto text-center mb-14">
      <Eyebrow align="center">The Menu</Eyebrow>
      <h2 class="font-display text-section-xl leading-display uppercase text-brand-charcoal">Brunch Menu</h2>
      <p class="text-brand-charcoal/50 text-sm italic mt-3">
        {venue.brunch.days} &middot; {venue.brunch.hours}
      </p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-5xl mx-auto">
      <MenuCard image="/photos/brunch-chicken-waffle.jpg" imageAlt="Chicken and waffle with maple syrup, fresh fruit, and home fries" name="Chicken & Waffle" category="food" />
      <MenuCard image="/photos/brunch-avocado-toast.jpg" imageAlt="Avocado toast with fried egg, heirloom tomatoes, and microgreens" name="Avocado Toast" category="food" />
      <MenuCard image="/photos/brunch-dishes-overhead.jpg" imageAlt="Coco Cabana brunch spread with French toast, eggs, and tropical dishes" name="Brunch Spread" category="food" />
      <MenuCard image="/photos/brunch-mimosas.jpg" imageAlt="Bottomless mimosa flight with Campo Viejo cava, pineapple bucket and copper flamingo" name="Bottomless Mimosas" description="Campo Viejo Cava · 2-Hour Bottomless · Classic, Tropical & Citrus" category="drinks" />
    </div>
  </section>

  <!-- RESERVE CTA -->
  <section class="bg-brand-charcoal px-6 sm:px-8 lg:px-12 py-16 sm:py-20 text-center">
    <h2 class="font-display text-section-xl leading-display uppercase text-brand-cream mb-2">Reserve</h2>
    <p class="accent-text text-accent-xl text-brand-pink mb-6">Your Brunch Table</p>
    <p class="text-brand-cream/60 mb-8">
      {venue.brunch.days} &middot; {venue.brunch.hours} &middot; {venue.address.street}, {venue.address.city}
    </p>
    <Button href={venue.reservationsUrl} variant="primary" external>Reserve Now</Button>
  </section>
</Layout>
