---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SplitSection from '../components/SplitSection.astro';
import FullBleedBanner from '../components/FullBleedBanner.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import MenuCard from '../components/MenuCard.astro';
import { venue } from '../data/venue';
import { brunchFood, brunchDrinks } from '../data/brunch';
import { getPhoto } from '../utils/images';
import { brunchPage } from '../lib/cms';
---

<Layout
  title={brunchPage.seoTitle}
  description={brunchPage.seoDescription}
  transparentNav={true}
>
  <PageHero
    image={getPhoto(brunchPage.heroImage.src)}
    imageAlt={brunchPage.heroImage.alt}
    imagePosition={brunchPage.heroImage.position}
  >
    <Eyebrow tone="dark">{brunchPage.heroEyebrow}</Eyebrow>
    <h1 class="font-display leading-ultra text-hero uppercase mb-2">{brunchPage.heroTitle}</h1>
    <p class="accent-text text-accent-xl text-brand-pink mb-4">{brunchPage.heroSubtitle}</p>
    <p class="text-brand-cream/70 text-sm uppercase tracking-label mb-8">
      {venue.brunch.days} &middot; {venue.brunch.hours}
    </p>
    <div class="flex flex-wrap gap-4">
      <Button href={venue.reservationsUrl} variant="primary" external>{brunchPage.primaryCtaText}</Button>
      <Button href={brunchPage.secondaryCtaHref as unknown as string} variant="ghost">{brunchPage.secondaryCtaText}</Button>
    </div>
  </PageHero>

  <!-- INFO STRIP -->
  <section class="bg-brand-charcoal text-brand-cream">
    <div class="max-w-4xl mx-auto grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-brand-cream/10">
      <div class="px-6 py-8 text-center">
        <p class="accent-text text-2xl text-brand-pink mb-1">{brunchPage.stats[0].value}</p>
        <p class="uppercase tracking-stat text-xs text-brand-cream/50">{brunchPage.stats[0].label}</p>
      </div>
      <div class="px-6 py-8 text-center">
        <p class="accent-text text-2xl text-brand-pink mb-1">{brunchPage.stats[1].value}</p>
        <p class="uppercase tracking-stat text-xs text-brand-cream/50">{brunchPage.stats[1].label}</p>
      </div>
    </div>
  </section>

  <!-- BRUNCH MENU -->
  <section id="brunch-menu" class="bg-brand-cream px-6 sm:px-8 lg:px-12 py-20 sm:py-28">
    <div class="max-w-2xl mx-auto text-center mb-14">
      <Eyebrow align="center">{brunchPage.sections[0].eyebrow}</Eyebrow>
      <h2 class="font-display text-section-xl leading-display uppercase text-brand-charcoal mb-4">{brunchPage.sections[0].title}</h2>
      <p class="text-brand-charcoal/60 leading-relaxed" set:html={brunchPage.sections[0].detail} />
    </div>

    <!-- Food -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-6 max-w-5xl mx-auto mb-20">
      {brunchFood.map(item => (
        <MenuCard name={item.name} image={item.image ? getPhoto(item.image) : undefined} imageAlt={item.imageAlt} imagePosition={item.imagePosition} category="food" />
      ))}
    </div>

    <!-- Drinks -->
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-10">
        <Eyebrow align="center">{brunchPage.sections[0].drinksEyebrow}</Eyebrow>
        <h3 class="font-display text-2xl leading-display uppercase text-brand-charcoal">{brunchPage.sections[0].drinksTitle}</h3>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-3xl mx-auto">
        {brunchDrinks.map(item => (
          <MenuCard name={item.name} image={item.image ? getPhoto(item.image) : undefined} imageAlt={item.imageAlt} description={item.description} category="drinks" />
        ))}
      </div>
    </div>
  </section>

  <!-- MIMOSA BANNER -->
  <FullBleedBanner
    image={getPhoto(brunchPage.mimosaPromo.image)}
    imageAlt={brunchPage.mimosaPromo.imageAlt}
    imagePosition={brunchPage.mimosaPromo.imagePosition}
    minHeight={brunchPage.mimosaPromo.minHeight}
  >
    <Eyebrow tone="dark">{brunchPage.mimosaPromo.eyebrow}</Eyebrow>
    <h2 class="font-display leading-display text-section-xl uppercase mb-2" set:html={brunchPage.mimosaPromo.title} />
    <p class="accent-text text-accent-xl text-brand-pink mb-6">{brunchPage.mimosaPromo.accent}</p>
    <p class="text-brand-cream/80 leading-relaxed mb-8" set:html={brunchPage.mimosaPromo.text} />
    <Button href={venue.reservationsUrl} variant="primary" external>{brunchPage.mimosaPromo.ctaText}</Button>
  </FullBleedBanner>

  <!-- ROOFTOP SPLIT -->
  <SplitSection
    image={getPhoto(brunchPage.rooftopPromo.image)}
    imageAlt={brunchPage.rooftopPromo.imageAlt}
    imageLeft={true}
    tone="dark"
  >
    <Eyebrow tone="dark">{brunchPage.rooftopPromo.eyebrow}</Eyebrow>
    <h2 class="font-display text-section-xl leading-display uppercase text-brand-cream mb-4">{brunchPage.rooftopPromo.title}</h2>
    <p class="accent-text text-accent-xl text-brand-pink mb-6">{brunchPage.rooftopPromo.accent}</p>
    <p class="text-brand-cream/70 leading-relaxed mb-8" set:html={brunchPage.rooftopPromo.text} />
    <Button href={venue.reservationsUrl} variant="primary" external>{brunchPage.rooftopPromo.ctaText}</Button>
  </SplitSection>

  <!-- RESERVE CTA -->
  <section class="bg-brand-charcoal px-6 sm:px-8 lg:px-12 py-16 sm:py-20 text-center">
    <h2 class="font-display text-section-xl leading-display uppercase text-brand-cream mb-2">{brunchPage.reserve.title}</h2>
    <p class="accent-text text-accent-xl text-brand-pink mb-6">{brunchPage.reserve.accent}</p>
    <p class="text-brand-cream/60 mb-8" set:html={brunchPage.reserve.detail} />
    <div class="flex flex-wrap gap-4 justify-center">
      <Button href={venue.reservationsUrl} variant="primary" external>{brunchPage.reserve.primaryCtaText}</Button>
      <Button href={venue.routes.menu} variant="ghost">{brunchPage.reserve.secondaryCtaText}</Button>
    </div>
  </section>
</Layout>
