---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ToastEventForm from '../components/ToastEventForm.astro';
import MapEmbed from '../components/MapEmbed.astro';
import { venue } from '../data/venue';
import { contactPage } from '../lib/cms';
import { getPhoto } from '../utils/images';
---

<Layout
  transparentNav={true}
  title={contactPage.seoTitle}
  description={contactPage.seoDescription}
>
  <PageHero
    image={contactPage.heroImage.src?.trim() ? getPhoto(contactPage.heroImage.src) : undefined}
    imageAlt={contactPage.heroImage.alt}
  >
    <Eyebrow tone="dark">{contactPage.heroEyebrow}</Eyebrow>
    <h1 class="font-display leading-ultra text-hero uppercase mb-6">{contactPage.heroTitle}</h1>
    <p class="text-brand-cream/80 leading-relaxed max-w-xl mb-8">{contactPage.heroText}</p>
    <Button href={venue.reservationsUrl} variant="primary" external>{contactPage.primaryCtaText}</Button>
  </PageHero>

  <!-- 3-COL INFO GRID -->
  <section class="bg-brand-charcoal text-brand-cream px-6 sm:px-8 lg:px-12 py-20 sm:py-28">
    <div class="max-w-5xl mx-auto grid md:grid-cols-3 gap-12">
      <div>
        <Eyebrow tone="dark">{contactPage.cards[0].eyebrow}</Eyebrow>
        <h2 class="font-display text-2xl uppercase text-brand-cream mb-4">{contactPage.cards[0].title}</h2>
        <p class="text-brand-cream/60 leading-relaxed mb-6">{contactPage.cards[0].text}</p>
        <div class="flex flex-col gap-3">
          <Button href={venue.reservationsUrl} variant="primary" external>{contactPage.cards[0].primaryCtaText}</Button>
          <Button href={venue.phoneHref} variant="ghost">{venue.phone}</Button>
        </div>
      </div>
      <div>
        <Eyebrow tone="dark">{contactPage.cards[1].eyebrow}</Eyebrow>
        <h2 class="font-display text-2xl uppercase text-brand-cream mb-4">{contactPage.cards[1].title}</h2>
        <p class="text-brand-cream/60 leading-relaxed mb-6">{contactPage.cards[1].text}</p>
        <div class="flex flex-col gap-3">
          <Button href="#inquiry-form" variant="primary">{contactPage.cards[1].primaryCtaText}</Button>
          <Button href={venue.routes.privateEvents} variant="ghost">{contactPage.cards[1].secondaryCtaText}</Button>
        </div>
      </div>
      <div>
        <Eyebrow tone="dark">{contactPage.cards[2].eyebrow}</Eyebrow>
        <h2 class="font-display text-2xl uppercase text-brand-cream mb-4">{contactPage.cards[2].title}</h2>
        <a href={venue.mapsUrl} target="_blank" rel="noopener noreferrer" class="block text-brand-cream hover:text-brand-pink transition-colors mb-2">
          {venue.address.street}<br />{venue.address.city}, {venue.address.state} {venue.address.zip}
        </a>
        <p class="text-brand-cream/60 text-sm mb-6">{venue.hotel}</p>
        <Button href={venue.mapsUrl} variant="ghost" external>{contactPage.cards[2].directionsCtaText}</Button>
      </div>
    </div>
  </section>

  <!-- HOURS + MAP -->
  <section class="bg-brand-cream px-6 sm:px-8 lg:px-12 py-20 sm:py-28">
    <div class="max-w-5xl mx-auto grid md:grid-cols-5 gap-px bg-brand-charcoal/10 border border-brand-charcoal/10">
      <div class="md:col-span-2 bg-brand-cream p-8 sm:p-10">
        <Eyebrow>{contactPage.hours.eyebrow}</Eyebrow>
        <h2 class="font-display text-section-xl leading-display uppercase text-brand-charcoal mb-6" set:html={contactPage.hours.title} />
        <div class="space-y-2 mb-8">
          {venue.hours.schedule.map(row => (
            <div class="flex justify-between gap-4 text-sm">
              <span class="text-brand-charcoal/60">{row.days}</span>
              <span class:list={[row.hours === 'Closed' ? 'text-brand-charcoal/30' : 'text-brand-charcoal']}>{row.hours}</span>
            </div>
          ))}
        </div>
        <p class="text-brand-charcoal/50 text-xs uppercase tracking-label">{venue.hours.shortSummary}</p>
      </div>
      <div class="md:col-span-3 min-h-[400px] overflow-hidden">
        <MapEmbed
          src={venue.mapsEmbedUrl}
          title={`Map to ${venue.fullName}`}
          class="w-full h-full border-0 min-h-[400px]"
        />
      </div>
    </div>
  </section>

  <!-- PRIVATE EVENT INQUIRY FORM -->
  <div id="inquiry-form">
    <ToastEventForm
      tone="dark"
      heading={contactPage.eventForm.heading}
      subheading={contactPage.eventForm.subheading}
    />
  </div>

  <!-- SOCIAL + CTA -->
  <section class="bg-brand-charcoal px-6 sm:px-8 lg:px-12 py-16 sm:py-20 text-center">
    <Eyebrow align="center" tone="dark">{contactPage.social.eyebrow}</Eyebrow>
    <h2 class="font-display text-section-xl leading-display uppercase text-brand-cream mb-4">{venue.social.instagramHandle}</h2>
    <p class="text-brand-cream/60 mb-8">{contactPage.social.text}</p>
    <div class="flex flex-wrap gap-4 justify-center">
      <Button href={venue.social.instagram} variant="primary" external>{contactPage.social.primaryCtaText}</Button>
      <Button href={venue.reservationsUrl} variant="ghost" external>{contactPage.social.secondaryCtaText}</Button>
    </div>
  </section>
</Layout>
