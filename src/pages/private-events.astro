---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SplitSection from '../components/SplitSection.astro';
import FullBleedBanner from '../components/FullBleedBanner.astro';
import EventCard from '../components/EventCard.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import TickList from '../components/TickList.astro';
import ToastEventForm from '../components/ToastEventForm.astro';
import { venue } from '../data/venue';
import { privateEvents } from '../data/events';
import { getPhoto } from '../utils/images';
import { privateEventsPage } from '../lib/cms';

const statsHtml = (stats: Array<{ value: string; label: string }>) =>
  stats
    .map(
      (stat) =>
        `<div class="px-5 py-8 text-center"> <p class="accent-text text-2xl text-brand-pink mb-1">${stat.value}</p> <p class="uppercase tracking-stat text-xs text-brand-cream/50">${stat.label}</p> </div>`,
    )
    .join(' ');
const processHtml = (steps: Array<{ number: string; title: string; text: string }>) =>
  steps
    .map(
      (step) =>
        `<div class="text-center"> <p class="accent-text text-4xl text-brand-pink mb-4">${step.number}</p> <h3 class="font-display uppercase tracking-feature text-sm text-brand-charcoal mb-3">${step.title}</h3> <p class="text-brand-charcoal/60 text-sm leading-relaxed">${step.text}</p> </div>`,
    )
    .join(' ');

---

<Layout
  transparentNav={true}
  title={privateEventsPage.seoTitle}
  description={privateEventsPage.seoDescription}
>
  <PageHero
    image={privateEventsPage.heroImage.src?.trim() ? getPhoto(privateEventsPage.heroImage.src) : undefined}
    imageAlt={privateEventsPage.heroImage.alt}
    imagePosition={privateEventsPage.heroImage.position}
  >
    <Eyebrow tone="dark">{privateEventsPage.heroEyebrow}</Eyebrow>
    <h1 class="font-display leading-ultra text-hero uppercase mb-6" set:html={privateEventsPage.heroTitle.replace(/\n/g, '<br />')} />
    <p class="text-brand-cream/80 leading-relaxed max-w-xl mb-8">{privateEventsPage.heroText}</p>
    <div class="flex flex-wrap gap-4">
      <Button href={privateEventsPage.primaryCtaHref as unknown as string} variant="primary">{privateEventsPage.primaryCtaText}</Button>
      <Button href={privateEventsPage.secondaryCtaHref as unknown as string} variant="ghost">{privateEventsPage.secondaryCtaText}</Button>
    </div>
  </PageHero>

  <!-- STATS STRIP -->
  <section class="bg-brand-charcoal text-brand-cream">
    <div class="max-w-5xl mx-auto grid grid-cols-2 sm:grid-cols-4 divide-x divide-y sm:divide-y-0 divide-brand-cream/10">
      <Fragment set:html={statsHtml(privateEventsPage.stats)} />
    </div>
  </section>

  <!-- WHAT WE HOST SPLIT -->
  <SplitSection
    id="what-we-host"
    image={privateEventsPage.whatWeHost.image?.trim() ? getPhoto(privateEventsPage.whatWeHost.image) : undefined}
    imageAlt={privateEventsPage.whatWeHost.imageAlt}
    imagePosition={privateEventsPage.whatWeHost.imagePosition}
    imageLeft={true}
    tone="light"
  >
    <Eyebrow>{privateEventsPage.whatWeHost.eyebrow}</Eyebrow>
    <h2 class="font-display text-section-xl leading-display uppercase text-brand-charcoal mb-6">{privateEventsPage.whatWeHost.title}</h2>
    <div class="mb-8">
      <TickList items={privateEventsPage.eventTypes.map((eventType) => eventType.title)} />
    </div>
    <p class="text-brand-charcoal/60 leading-relaxed mb-8" set:html={privateEventsPage.whatWeHost.text} />
    <Button href={venue.phoneHref} variant="primary">{privateEventsPage.whatWeHost.ctaText}</Button>
  </SplitSection>

  <!-- EVENTS GRID -->
  <section id="events-grid" class="bg-brand-charcoal px-6 sm:px-8 lg:px-12 py-20 sm:py-28">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <Eyebrow align="center" tone="dark">{privateEventsPage.eventGrid.eyebrow}</Eyebrow>
      <h2 class="font-display text-section-xl leading-display uppercase text-brand-cream">{privateEventsPage.eventGrid.title}</h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      {privateEvents.map(event => (
        <EventCard
          image={event.image?.trim() ? getPhoto(event.image) : undefined}
          imageAlt={event.imageAlt}
          imagePosition={event.imagePosition}
          category={event.category}
          title={event.title}
          description={event.description}
          detail={event.detail}
          href={event.href}
        />
      ))}
    </div>
  </section>

  <!-- ATMOSPHERE BANNER -->
  <FullBleedBanner
    image={privateEventsPage.setting.image?.trim() ? getPhoto(privateEventsPage.setting.image) : undefined}
    imageAlt={privateEventsPage.setting.imageAlt}
    imagePosition={privateEventsPage.setting.imagePosition}
    gradientDirection={privateEventsPage.setting.gradientDirection as 'left'}
    minHeight={privateEventsPage.setting.minHeight}
  >
    <Eyebrow tone="dark">{privateEventsPage.setting.eyebrow}</Eyebrow>
    <h2 class="font-display leading-display text-section-xl uppercase mb-2" set:html={privateEventsPage.setting.title} />
    <p class="accent-text text-accent-xl text-brand-pink mb-6">{privateEventsPage.setting.accent}</p>
    <p class="text-brand-cream/80 leading-relaxed mb-8">{privateEventsPage.setting.text}</p>
    <Button href={venue.phoneHref} variant="primary">{privateEventsPage.setting.ctaText}</Button>
  </FullBleedBanner>

  <!-- HOW IT WORKS -->
  <section class="bg-brand-cream px-6 sm:px-8 lg:px-12 py-20 sm:py-28">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <Eyebrow align="center">{privateEventsPage.process.eyebrow}</Eyebrow>
      <h2 class="font-display text-section-xl leading-display uppercase text-brand-charcoal">{privateEventsPage.process.title}</h2>
    </div>
    <div class="max-w-4xl mx-auto grid md:grid-cols-3 gap-8">
      <Fragment set:html={processHtml(privateEventsPage.process.steps)} />
    </div>
  </section>

  <!-- INQUIRY FORM -->
  <div id="inquiry-form">
    <ToastEventForm tone="dark" />
  </div>

  <!-- CTA -->
  <section class="bg-brand-charcoal px-6 sm:px-8 lg:px-12 py-16 sm:py-20 text-center">
    <Eyebrow align="center" tone="dark">{privateEventsPage.finalCta.eyebrow}</Eyebrow>
    <h2 class="font-display text-section-xl leading-display uppercase text-brand-cream mb-2">{privateEventsPage.finalCta.title}</h2>
    <p class="text-brand-cream/60 mb-8" set:html={privateEventsPage.finalCta.detail} />
    <div class="flex flex-wrap gap-4 justify-center">
      <Button href={venue.phoneHref} variant="primary">{privateEventsPage.finalCta.primaryCtaText}</Button>
      <Button href={venue.routes.contact} variant="ghost">{privateEventsPage.finalCta.secondaryCtaText}</Button>
    </div>
  </section>
</Layout>
