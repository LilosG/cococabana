---
import Layout from '../../layouts/Layout.astro';
import PrivateEventDetail from '../../components/PrivateEventDetail.astro';
import PrivateEventDetailFinal from '../../components/PrivateEventDetailFinal.astro';
import ToastEventForm from '../../components/ToastEventForm.astro';
import { venue } from '../../data/venue';
import { privateEventBirthdayParties as page } from '../../lib/cms';

const serviceSchema = {
  "@type": "Service",
  "@id": "https://cococabanaoside.com/private-events/birthday-parties#service",
  "name": "Birthday Party Venue — Coco Cabana Rooftop Bar",
  "description": `Private birthday party venue at ${venue.fullName} — rooftop bar atop ${venue.hotel} in Downtown ${venue.address.city}, CA. Full bar, open air, and a view above the Pacific.`,
  "url": "https://cococabanaoside.com/private-events/birthday-parties",
  "provider": { "@type": "BarOrPub", "name": venue.fullName, "address": { "@type": "PostalAddress", "streetAddress": venue.address.street, "addressLocality": venue.address.city, "addressRegion": venue.address.state, "postalCode": venue.address.zip }, "telephone": venue.phone },
  "areaServed": { "@type": "City", "name": venue.address.city },
};
---

<Layout transparentNav={true} title={page.seoTitle} description={page.seoDescription} extraGraph={[serviceSchema]}>
  <PrivateEventDetail page={page} />
  <div id="inquiry-form">
    <ToastEventForm tone="dark" />
  </div> <PrivateEventDetailFinal page={page} />
</Layout>
