---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import TickList from '../components/TickList.astro';
import MenuCard from '../components/MenuCard.astro';
import { venue } from '../data/venue';
import { menuSections } from '../data/menu';
import { getPhoto } from '../utils/images';
import { homePage } from '../lib/cms';
import MapEmbed from '../components/MapEmbed.astro';

// Homepage shows a curated preview only — the full menu (all items, every
// section) lives on /menu and carries the Menu/MenuItem schema. Curation
// happens via the `featured` flag in Keystatic on the same menu item entry,
// so there's one source of truth, not a duplicated homepage-only list.
const FEATURED_LIMIT = 6;
const foodItems = menuSections.find(s => s.id === 'food')!.items
  .filter(item => item.featured)
  .slice(0, FEATURED_LIMIT);
const cocktailItems = menuSections.find(s => s.id === 'cocktails')!.items
  .filter(item => item.featured)
  .slice(0, FEATURED_LIMIT);
const heroImage = homePage.heroImage.src?.trim() ? getPhoto(homePage.heroImage.src) : undefined;
const welcomeImage = homePage.welcome.image?.trim() ? getPhoto(homePage.welcome.image) : undefined;
const barImage = homePage.bar.image?.trim() ? getPhoto(homePage.bar.image) : undefined;
const brunchImage = homePage.brunch.image?.trim() ? getPhoto(homePage.brunch.image) : undefined;
const viewImage = homePage.view.image?.trim() ? getPhoto(homePage.view.image) : undefined;
const cabanaImage = homePage.cabana.image?.trim() ? getPhoto(homePage.cabana.image) : undefined;
const liveMusicImage = homePage.liveMusic.image?.trim() ? getPhoto(homePage.liveMusic.image) : undefined;
const privateEventsImage = homePage.privateEvents.image?.trim() ? getPhoto(homePage.privateEvents.image) : undefined;
const atmosphereImages = homePage.atmosphere.gallery.map((image) => ({
  ...image,
  resolved: image.src?.trim() ? getPhoto(image.src) : undefined,
}));
const atmosphereFeature = atmosphereImages[0];
const atmosphereGrid = atmosphereImages.slice(1, 5);
---

<Layout
  title={homePage.seoTitle}
  description={homePage.seoDescription}
  transparentNav={true}
>

  <!-- ════════════════════════════════════════════════════════════
       1 · HERO
       ════════════════════════════════════════════════════════════ -->
  <section class="relative min-h-screen flex items-end overflow-hidden">
    <div class="absolute inset-0">
      {heroImage && (
        <Image
          src={heroImage}
          alt={homePage.heroImage.alt}
          class={homePage.heroImage.position}
          fetchpriority="high"
          loading="eager"
        />
      )}
      <div class="absolute inset-0 bg-gradient-to-t from-brand-charcoal/85 via-brand-charcoal/25 to-transparent"></div>
      <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-brand-charcoal/45 to-transparent"></div>
    </div>
    <div class="relative z-10 px-6 sm:px-8 lg:px-12 pb-20 sm:pb-28 w-full text-brand-cream">
      <Eyebrow tone="dark">{homePage.heroEyebrow}</Eyebrow>
      <h1 class="font-display leading-ultra text-hero uppercase mb-2">{homePage.heroTitle}</h1>
      <p class="uppercase tracking-feature text-sm sm:text-base text-brand-cream/80 mb-8">{homePage.heroSubtitle}</p>
      <div class="flex flex-wrap gap-4">
        <Button href={venue.menuUrl} variant="primary" external>{homePage.primaryCtaText}</Button>
        <Button href={homePage.secondaryCtaHref} variant="ghost">{homePage.secondaryCtaText}</Button>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       INFO STRIP
       ════════════════════════════════════════════════════════════ -->
  <section class="bg-brand-charcoal text-brand-cream">
    <div class="max-w-5xl mx-auto grid grid-cols-2 sm:grid-cols-4 divide-x divide-y sm:divide-y-0 divide-brand-cream/10">
      <!-- Hours Today — dynamic via client JS -->
      <div class="px-5 py-8 text-center">
        <p class="uppercase tracking-stat text-xs text-brand-cream/50 mb-2">{homePage.stats[0].label}</p>
        <p id="info-hours" class="accent-text text-xl sm:text-2xl text-brand-pink leading-tight">{homePage.stats[0].value}</p>
        <p id="info-day" class="uppercase tracking-stat text-xs text-brand-cream/40 mt-1">{homePage.stats[0].detail}</p>
      </div>
      <!-- Weekend Brunch -->
      <div class="px-5 py-8 text-center">
        <p class="uppercase tracking-stat text-xs text-brand-cream/50 mb-2">{homePage.stats[1].label}</p>
        <p class="accent-text text-xl sm:text-2xl text-brand-pink leading-tight">{venue.brunch.days}</p>
        <p class="uppercase tracking-stat text-xs text-brand-cream/40 mt-1">{venue.brunch.hours}</p>
      </div>
      <!-- DJ Nights -->
      <div class="px-5 py-8 text-center">
        <p class="uppercase tracking-stat text-xs text-brand-cream/50 mb-2">{homePage.stats[2].label}</p>
        <p class="accent-text text-xl sm:text-2xl text-brand-pink leading-tight">{venue.djNights.days}</p>
        <p class="uppercase tracking-stat text-xs text-brand-cream/40 mt-1">{venue.djNights.label}</p>
      </div>
      <!-- Location -->
      <div class="px-5 py-8 text-center">
        <p class="uppercase tracking-stat text-xs text-brand-cream/50 mb-2">{homePage.stats[3].label}</p>
        <p class="accent-text text-xl sm:text-2xl text-brand-pink leading-tight">{homePage.stats[3].value}</p>
        <p class="uppercase tracking-stat text-xs text-brand-cream/40 mt-1">{venue.address.street}</p>
      </div>
    </div>
  </section>

  <script define:vars={{ schedule: venue.hours.schedule }}>
    const DAY_NAMES = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
    const today = DAY_NAMES[new Date().getDay()];
    const entry = schedule.find(row => {
      const parts = row.days.split(' – ');
      if (parts.length === 1) return parts[0].trim() === today;
      const start = DAY_NAMES.indexOf(parts[0].trim());
      const end   = DAY_NAMES.indexOf(parts[parts.length - 1].trim());
      const idx   = DAY_NAMES.indexOf(today);
      return idx >= start && idx <= end;
    });
    const hoursEl = document.getElementById('info-hours');
    const dayEl   = document.getElementById('info-day');
    if (hoursEl && entry) hoursEl.textContent = entry.hours;
    if (dayEl)            dayEl.textContent   = today;
  </script>

  <!-- ════════════════════════════════════════════════════════════
       2 · WELCOME — image-dominant 60/40 split, cream
       Image fills section height — no aspect-ratio cap.
       ════════════════════════════════════════════════════════════ -->
  <section class="bg-brand-cream overflow-hidden">
    <div class="max-w-7xl mx-auto grid md:grid-cols-[3fr_2fr] items-stretch min-h-[560px] md:min-h-[640px]">
      <div class="relative min-h-[380px] md:min-h-0">
        {welcomeImage && (
          <Image
            src={welcomeImage}
            alt={homePage.welcome.imageAlt}
            loading="lazy"
            class="absolute inset-0 w-full h-full object-cover"
          />
        )}
      </div>
      <div class="px-8 sm:px-10 lg:px-14 py-16 sm:py-20 flex flex-col justify-center">
        <Eyebrow>{homePage.welcome.eyebrow}</Eyebrow>
        <h2 class="font-display text-section-xl leading-display uppercase text-brand-charcoal" set:html={homePage.welcome.title} />
        <p class="accent-text text-accent-xl text-brand-pink mb-6">{homePage.welcome.accent}</p>
        <p class="text-brand-charcoal/70 leading-relaxed mb-8" set:html={homePage.welcome.text} />
        <div class="flex flex-wrap gap-4">
          <Button href={venue.reservationsUrl} variant="primary" external>{homePage.welcome.primaryCtaText}</Button>
          <Button href={venue.routes.venue} variant="secondary">{homePage.welcome.secondaryCtaText}</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       3 · THE BAR — full-bleed banner, breaks cream→cream rhythm
       Distinct identity from Welcome: bar program, not venue intro.
       Matches Park101's dark full-bleed chapter-break between
       the welcome split and the food/drinks sections.
       ════════════════════════════════════════════════════════════ -->
  <section class="relative min-h-[580px] sm:min-h-[640px] flex items-center overflow-hidden">
    <div class="absolute inset-0">
      {barImage && (
        <Image
          src={barImage}
          alt={homePage.bar.imageAlt}
          class={homePage.bar.imagePosition}
          loading="lazy"
        />
      )}
      <div class="absolute inset-0 bg-gradient-to-r from-brand-charcoal/88 via-brand-charcoal/50 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-brand-charcoal/50 via-transparent to-transparent"></div>
    </div>
    <div class="relative z-10 px-6 sm:px-8 lg:px-12 py-24 sm:py-32 max-w-xl text-brand-cream">
      <Eyebrow tone="dark">{homePage.bar.eyebrow}</Eyebrow>
      <h2 class="font-display leading-display text-section-xl uppercase mb-2" set:html={homePage.bar.title} />
      <p class="accent-text text-accent-xl text-brand-pink mb-6">{homePage.bar.accent}</p>
      <p class="text-brand-cream/80 leading-relaxed mb-8" set:html={homePage.bar.text} />
      <div class="flex flex-wrap gap-4">
        <Button href={`${venue.routes.menu}#cocktails`} variant="primary">{homePage.bar.primaryCtaText}</Button>
        <Button href={venue.reservationsUrl} variant="ghost" external>{homePage.bar.secondaryCtaText}</Button>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       4 · FOOD — cream, curated 2×3 (6 featured items). Full menu
       lives on /menu. Eyebrow: "The Kitchen" (not duplicate "Food")
       ════════════════════════════════════════════════════════════ -->
  <section class="bg-brand-cream px-6 sm:px-8 lg:px-12 py-20 sm:py-28">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <Eyebrow align="center">{homePage.food.eyebrow}</Eyebrow>
      <h2 class="font-display text-section-xl leading-display uppercase text-brand-charcoal">{homePage.food.title}</h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-6 max-w-5xl mx-auto mb-10">
      {foodItems.map(item => (
        <MenuCard name={item.name} image={item.image?.trim() ? getPhoto(item.image) : undefined} imageAlt={item.imageAlt} imagePosition={item.imagePosition} category="food" />
      ))}
    </div>
    <div class="text-center">
      <Button href={venue.orderUrl} variant="secondary" external>{homePage.food.ctaText}</Button>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       4 · COCKTAILS — dark, curated 2×3 (6 featured items, matches
       the food section grid). Full list lives on /menu.
       ════════════════════════════════════════════════════════════ -->
  <section class="bg-brand-charcoal px-6 sm:px-8 lg:px-12 py-20 sm:py-28">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <Eyebrow align="center" tone="dark">{homePage.cocktails.eyebrow}</Eyebrow>
      <h2 class="font-display text-section-xl leading-display uppercase text-brand-cream">{homePage.cocktails.title}</h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-6 max-w-5xl mx-auto mb-10">
      {cocktailItems.map(item => (
        <MenuCard name={item.name} description={item.description} image={item.image?.trim() ? getPhoto(item.image) : undefined} imageAlt={item.imageAlt} imagePosition={item.imagePosition} category="drinks" tone="dark" />
      ))}
    </div>
    <div class="text-center">
      <Button href={venue.routes.menu + '#cocktails'} variant="ghost">{homePage.cocktails.ctaText}</Button>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       5 · BRUNCH BANNER — full-bleed, distinct identity
       ════════════════════════════════════════════════════════════ -->
  <section class="relative min-h-[640px] sm:min-h-[700px] flex items-center overflow-hidden">
    <div class="absolute inset-0">
      {brunchImage && (
        <Image
          src={brunchImage}
          alt={homePage.brunch.imageAlt}
          class={homePage.brunch.imagePosition}
          loading="lazy"
        />
      )}
      <div class="absolute inset-0 bg-gradient-to-r from-brand-charcoal/90 via-brand-charcoal/55 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-brand-charcoal/50 via-transparent to-transparent"></div>
    </div>
    <div class="relative z-10 px-6 sm:px-8 lg:px-12 py-24 sm:py-32 max-w-xl text-brand-cream">
      <Eyebrow tone="dark">{homePage.brunch.eyebrow}</Eyebrow>
      <h2 class="font-display leading-display text-section-xl uppercase mb-2" set:html={homePage.brunch.title} />
      <p class="accent-text text-accent-xl text-brand-pink mb-6">{venue.brunch.days}</p>
      <p class="text-brand-cream/80 leading-relaxed mb-2">{venue.brunch.hours}</p>
      <p class="text-brand-cream/60 text-sm mb-8">{venue.brunch.highlight}</p>
      <div class="flex flex-wrap gap-4">
        <Button href={venue.routes.brunch} variant="primary">{homePage.brunch.primaryCtaText}</Button>
        <Button href={venue.reservationsUrl} variant="ghost" external>{homePage.brunch.secondaryCtaText}</Button>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       6 · THE VIEW — dark, split image-right
       Real sunset photo — real copy about the views
       ════════════════════════════════════════════════════════════ -->
  <section class="bg-brand-charcoal overflow-hidden">
    <div class="max-w-7xl mx-auto grid md:grid-cols-[2fr_3fr] items-stretch min-h-[520px] md:min-h-[600px]">
      <div class="px-8 sm:px-10 lg:px-14 py-16 sm:py-20 flex flex-col justify-center md:order-1">
        <Eyebrow tone="dark">{homePage.view.eyebrow}</Eyebrow>
        <h2 class="font-display text-section-xl leading-display uppercase text-brand-cream mb-4">{homePage.view.title}</h2>
        <p class="accent-text text-accent-xl text-brand-pink mb-6">{homePage.view.accent}</p>
        <p class="text-brand-cream/70 leading-relaxed mb-8" set:html={homePage.view.text} />
        <Button href={venue.routes.venue} variant="ghost">{homePage.view.ctaText}</Button>
      </div>
      <div class="relative min-h-[360px] md:min-h-0 md:order-2">
        {viewImage && (
          <Image
            src={viewImage}
            alt={homePage.view.imageAlt}
            loading="lazy"
            class={homePage.view.imagePosition}
          />
        )}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       8 · THE CABANA — navy, split image-LEFT text-RIGHT
       Flipped from The View (text-left/image-right) to break
       the same-layout-twice pattern. Alternating is the standard
       across the GPH portfolio.
       ════════════════════════════════════════════════════════════ -->
  <section id="cabana" class="bg-brand-navy overflow-hidden">
    <div class="max-w-7xl mx-auto grid md:grid-cols-[3fr_2fr] items-stretch min-h-[520px] md:min-h-[600px]">
      <div class="relative min-h-[360px] md:min-h-0 md:order-1">
        {cabanaImage && (
          <Image
            src={cabanaImage}
            alt={homePage.cabana.imageAlt}
            loading="lazy"
            class={homePage.cabana.imagePosition}
          />
        )}
      </div>
      <div class="px-8 sm:px-10 lg:px-14 py-16 sm:py-20 flex flex-col justify-center md:order-2">
        <Eyebrow tone="dark">{homePage.cabana.eyebrow}</Eyebrow>
        <h2 class="font-display text-section-xl leading-display uppercase text-brand-cream mb-4">{homePage.cabana.title}</h2>
        <p class="accent-text text-accent-xl text-brand-pink mb-6">{homePage.cabana.accent}</p>
        <p class="text-brand-cream/70 leading-relaxed mb-8" set:html={homePage.cabana.text} />
        <Button href={venue.reservationsUrl} variant="primary" external>{homePage.cabana.ctaText}</Button>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       8 · LIVE MUSIC — full-bleed banner, own distinct photo
       ════════════════════════════════════════════════════════════ -->
  <section class="relative min-h-[600px] sm:min-h-[680px] flex items-center overflow-hidden">
    <div class="absolute inset-0">
      {liveMusicImage && (
        <Image
          src={liveMusicImage}
          alt={homePage.liveMusic.imageAlt}
          class={homePage.liveMusic.imagePosition}
          loading="lazy"
        />
      )}
      <div class="absolute inset-0 bg-gradient-to-r from-brand-charcoal/90 via-brand-charcoal/55 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-brand-charcoal/60 via-transparent to-transparent"></div>
    </div>
    <div class="relative z-10 px-6 sm:px-8 lg:px-12 py-24 sm:py-32 max-w-xl text-brand-cream">
      <Eyebrow tone="dark">{homePage.liveMusic.eyebrow}</Eyebrow>
      <h2 class="font-display leading-display text-section-xl uppercase mb-2" set:html={homePage.liveMusic.title} />
      <p class="accent-text text-accent-xl text-brand-pink mb-6">{homePage.liveMusic.accent}</p>
      <p class="text-brand-cream/80 leading-relaxed mb-8" set:html={homePage.liveMusic.text} />
      <Button href={venue.reservationsUrl} variant="primary" external>{homePage.liveMusic.ctaText}</Button>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       10 · THE DETAILS — dark, tall-left + 2×2-right mosaic
       Explicit container height (md:h-[560px]) so both sides fill
       identically — no gaps. Left image fills container. Right grid
       uses grid-rows-2 to split height into 2 equal rows. Tiles use
       wrapper divs (not bare imgs) so h-full works correctly.
       ════════════════════════════════════════════════════════════ -->
  <section id="atmosphere" class="bg-brand-charcoal px-6 sm:px-8 lg:px-12 py-20 sm:py-28">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <Eyebrow align="center" tone="dark">{homePage.atmosphere.eyebrow}</Eyebrow>
      <h2 class="font-display text-section-xl leading-display uppercase text-brand-cream">{homePage.atmosphere.title}</h2>
    </div>
    <div class="flex flex-col md:flex-row gap-3 max-w-5xl mx-auto md:h-[560px] lg:h-[640px]">
      <!-- Left: tall image — fixed height mobile, fills container desktop -->
      <div class="md:flex-1 min-w-0 overflow-hidden h-72 md:h-auto">
        {atmosphereFeature?.resolved && (
          <Image
            src={atmosphereFeature.resolved}
            alt={atmosphereFeature.alt}
            loading="lazy"
            class={atmosphereFeature.class}
          />
        )}
      </div>
      <!-- Right: 2×2 grid — grid-rows-2 splits container height into 2 equal rows -->
      <div class="md:flex-1 min-w-0 grid grid-cols-2 gap-3 md:grid-rows-2">
        {atmosphereGrid.map((image) => (
          <div class="overflow-hidden aspect-square md:aspect-auto">
            {image.resolved && (
              <Image src={image.resolved} alt={image.alt} loading="lazy" class={image.class} />
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       10 · PRIVATE EVENTS — cream, split image-left
       Real lifestyle photo showing a group enjoying the space
       ════════════════════════════════════════════════════════════ -->
  <section class="bg-brand-cream overflow-hidden">
    <div class="max-w-7xl mx-auto grid md:grid-cols-[3fr_2fr] items-stretch min-h-[520px] md:min-h-[580px]">
      <div class="relative min-h-[360px] md:min-h-0">
        {privateEventsImage && (
          <Image
            src={privateEventsImage}
            alt={homePage.privateEvents.imageAlt}
            loading="lazy"
            class={homePage.privateEvents.imagePosition}
          />
        )}
      </div>
      <div class="px-8 sm:px-10 lg:px-14 py-16 sm:py-20 flex flex-col justify-center">
        <Eyebrow>{homePage.privateEvents.eyebrow}</Eyebrow>
        <h2 class="font-display text-section-xl leading-display uppercase text-brand-charcoal">{homePage.privateEvents.title}</h2>
        <p class="accent-text text-accent-xl text-brand-pink mb-6">{homePage.privateEvents.accent}</p>
        <p class="text-brand-charcoal/70 leading-relaxed mb-6" set:html={homePage.privateEvents.text} />
        <div class="mb-8">
          <TickList items={homePage.privateEvents.features} />
        </div>
        <Button href={venue.routes.privateEvents} variant="dark">{homePage.privateEvents.ctaText}</Button>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       11 · FIND US — charcoal (breaks cream stack from Private Events)
       ════════════════════════════════════════════════════════════ -->
  <section id="hours" class="bg-brand-charcoal px-6 sm:px-8 lg:px-12 py-20 sm:py-28">
    <div class="max-w-2xl mx-auto text-center mb-12">
      <Eyebrow align="center" tone="dark">{homePage.visit.eyebrow}</Eyebrow>
      <h2 class="font-display text-section-xl leading-display uppercase text-brand-cream">{homePage.visit.title}</h2>
      <p class="accent-text text-accent-xl text-brand-pink">{homePage.visit.accent}</p>
    </div>

    <div class="max-w-5xl mx-auto grid md:grid-cols-5 gap-px bg-brand-cream/10 border border-brand-cream/10">
      <div class="md:col-span-2 bg-brand-charcoal p-8 sm:p-10 flex flex-col justify-center">
        <p class="uppercase tracking-label text-xs text-brand-pink mb-2">{homePage.visit.addressLabel}</p>
        <a href={venue.mapsUrl} target="_blank" rel="noopener noreferrer" class="block text-lg text-brand-cream hover:text-brand-pink transition-colors mb-6">
          {venue.address.street}<br />
          {venue.address.city}, {venue.address.state} {venue.address.zip}
        </a>
        <p class="uppercase tracking-label text-xs text-brand-pink mb-2">{homePage.visit.callLabel}</p>
        <a href={venue.phoneHref} class="block text-lg text-brand-cream hover:text-brand-pink transition-colors mb-6">{venue.phone}</a>
        <p class="uppercase tracking-label text-xs text-brand-pink mb-2">{homePage.visit.hoursLabel}</p>
        <div class="space-y-1 mb-8">
          {venue.hours.schedule.map(row => (
            <div class="flex justify-between gap-4 text-sm">
              <span class="text-brand-cream/60">{row.days}</span>
              <span class:list={[row.hours === 'Closed' ? 'text-brand-cream/30' : 'text-brand-cream']}>{row.hours}</span>
            </div>
          ))}
        </div>
        <div class="flex flex-wrap gap-4">
          <Button href={venue.reservationsUrl} variant="primary" external>{homePage.visit.reserveCtaText}</Button>
          <Button href={venue.mapsUrl} variant="ghost" external>{homePage.visit.directionsCtaText}</Button>
        </div>
        <p class="text-brand-cream/40 text-xs uppercase tracking-label mt-6">
          <a href={venue.routes.faq} class="hover:text-brand-pink transition-colors">{homePage.visit.faqCtaText}</a>
        </p>
      </div>
      <div class="md:col-span-3 aspect-[4/3] md:aspect-auto w-full h-full overflow-hidden min-h-[360px]">
        <MapEmbed
          src={venue.mapsEmbedUrl}
          title={`Map to ${venue.fullName}`}
          class="w-full h-full border-0"
        />
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════
       12 · RESERVE CTA BAND
       ════════════════════════════════════════════════════════════ -->
  <section class="bg-brand-charcoal border-t border-brand-cream/10 px-6 sm:px-8 lg:px-12 py-16 sm:py-20 text-center">
    <h2 class="font-display text-section-xl leading-display uppercase text-brand-cream mb-2">{homePage.reserve.title}</h2>
    <p class="accent-text text-accent-xl text-brand-pink mb-6">{homePage.reserve.accent}</p>
    <p class="text-brand-cream/60 mb-8">
      {venue.address.street}, {venue.address.city}, {venue.address.state} &middot; {venue.phone}
    </p>
    <Button href={venue.reservationsUrl} variant="primary" external>{homePage.reserve.ctaText}</Button>
  </section>

</Layout>
