---
interface Props {
  src: string;
  title: string;
  placeholderImagePath?: string;
  /** Extra classes applied to the wrapper — mirrors whatever the replaced iframe had on it */
  class?: string;
}

const { src, title, placeholderImagePath, class: className = 'w-full h-full border-0' } = Astro.props;
const wrapperId = `map-${Math.random().toString(36).slice(2, 9)}`;
---

<div
  id={wrapperId}
  class={className}
  data-map-src={src}
  data-map-title={title}
  style="position:relative;display:flex;align-items:center;justify-content:center;background:var(--color-brand-charcoal,#2b2420);min-height:inherit;"
>
  {placeholderImagePath ? (
    <img
      src={placeholderImagePath}
      alt={title}
      style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0.35;"
    />
  ) : (
    <div style="position:absolute;inset:0;background:linear-gradient(135deg,var(--color-brand-charcoal,#2b2420) 0%,var(--color-brand-navy,#3c4e60) 100%);opacity:0.9;"></div>
  )}
  <div style="position:relative;z-index:1;text-align:center;padding:2rem;">
    <p style="color:var(--color-brand-cream,#faf5ea);font-family:var(--font-display,'Jost Variable',sans-serif);font-size:0.75rem;letter-spacing:0.25em;text-transform:uppercase;margin-bottom:1rem;opacity:0.7;">
      Map not loaded — connects to Google when loaded
    </p>
    <button
      type="button"
      class="map-load-btn"
      style="background:var(--color-brand-pink,#cc6f8d);color:var(--color-brand-cream,#faf5ea);border:none;border-radius:0.375rem;padding:0.625rem 1.5rem;font-family:var(--font-display,'Jost Variable',sans-serif);font-size:0.875rem;font-weight:600;letter-spacing:0.12em;text-transform:uppercase;cursor:pointer;transition:opacity 0.15s ease;"
      onmouseover="this.style.opacity='0.85'"
      onmouseout="this.style.opacity='1'"
    >
      Load map
    </button>
  </div>
</div>

<script is:inline define:vars={{ wrapperId }}>
  (function () {
    var wrapper = document.getElementById(wrapperId);
    if (!wrapper) return;
    var btn = wrapper.querySelector('.map-load-btn');
    if (!btn) return;
    btn.addEventListener('click', function () {
      var mapSrc = wrapper.getAttribute('data-map-src');
      var mapTitle = wrapper.getAttribute('data-map-title');
      var iframe = document.createElement('iframe');
      iframe.src = mapSrc;
      iframe.title = mapTitle;
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer';
      iframe.style.cssText = 'display:block;width:100%;height:100%;border:0;min-height:inherit;';
      wrapper.innerHTML = '';
      wrapper.style.cssText = '';
      wrapper.appendChild(iframe);
    }, { once: true });
  })();
</script>
