---
// Holds the place for a real photo. Swap by deleting the ImagePlaceholder
// usage and dropping in a real <img>/<Image> at the same spot — the
// surrounding layout (grid cell, aspect ratio) is already sized correctly.
//
// `category` should match the asset folder the real file will live in:
// public/images/venue/, public/images/food/, public/images/drinks/,
// public/images/lifestyle-event/

interface Props {
  label: string;
  category: 'venue' | 'food' | 'drinks' | 'lifestyle-event';
  aspect?: string;
  tone?: 'light' | 'dark';
  class?: string;
}

const { label, category, aspect = 'aspect-[4/5]', tone = 'light', class: className = '' } = Astro.props;

const toneClasses =
  tone === 'dark'
    ? 'bg-gradient-to-br from-brand-blush/20 to-brand-cream/10 border-brand-cream/15'
    : 'bg-gradient-to-br from-brand-blush/25 to-brand-charcoal/10 border-brand-charcoal/10';

const labelClasses = tone === 'dark' ? 'text-brand-cream/50' : 'text-brand-charcoal/40';
const subLabelClasses = tone === 'dark' ? 'text-brand-cream/30' : 'text-brand-charcoal/25';
---

<div
  class:list={[
    'relative flex flex-col items-center justify-center gap-3 border',
    toneClasses,
    aspect,
    className,
  ]}
>
  <svg
    class:list={['w-7 h-7', tone === 'dark' ? 'text-brand-cream/30' : 'text-brand-charcoal/25']}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.25"
  >
    <rect x="3" y="5" width="18" height="14" rx="1" />
    <circle cx="8.5" cy="10" r="1.5" />
    <path d="M21 16l-5.5-5.5a1 1 0 0 0-1.4 0L7 18" />
  </svg>
  <span class:list={['text-xs uppercase tracking-label text-center px-4', labelClasses]}>
    {label}<br />
    <span class={subLabelClasses}>[{category}]</span>
  </span>
</div>
