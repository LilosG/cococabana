---
interface Props {
  tone?: 'light' | 'dark';
  heading?: string;
  subheading?: string;
}

const {
  tone = 'dark',
  heading = 'Start Your Inquiry',
  subheading = 'Fill out the form below and our team will be in touch within 1 business day to confirm availability and talk through the details.',
} = Astro.props;

const bg          = tone === 'dark' ? 'bg-brand-charcoal' : 'bg-brand-cream';
const headingColor = tone === 'dark' ? 'text-brand-cream' : 'text-brand-charcoal';
const subColor    = tone === 'dark' ? 'text-brand-cream/60' : 'text-brand-charcoal/60';
const phoneColor  = tone === 'dark' ? 'text-brand-cream/40' : 'text-brand-charcoal/40';
---

<section class:list={[bg, 'px-6 sm:px-8 lg:px-12 py-20 sm:py-28']}>
  <div class="max-w-3xl mx-auto">

    <!-- Section label -->
    <div class="flex flex-col items-center gap-3 mb-10 text-center">
      <p class="uppercase tracking-eyebrow-lg text-xs text-brand-pink">Private Events</p>
      <span class="block w-8 h-px bg-brand-pink"></span>
      <h2 class:list={['font-display text-section-xl leading-display uppercase', headingColor]}>
        {heading}
      </h2>
      <p class:list={['text-sm leading-relaxed max-w-md', subColor]}>
        {subheading}
      </p>
    </div>

    <!-- Toast iframe — framed as a white card so the form interior reads cleanly -->
    <div class="bg-white overflow-hidden" style="box-shadow: 0 2px 24px 0 rgba(0,0,0,0.10);">
      <iframe
        src="https://www.toasttab.com/invoice/lead?rx=92e5306b-e932-4406-876b-91277626cb5c&ot=fb59fde7-2560-4025-bb15-abbd63a46f88&form=1"
        title="Private Event Inquiry Form"
        loading="lazy"
        scrolling="no"
        style="display:block;border:0;width:100%;height:900px;"
      ></iframe>
    </div>

    <!-- Phone fallback -->
    <p class:list={['text-center text-xs mt-6 uppercase tracking-label', phoneColor]}>
      Prefer to call? <a href="tel:+18583047725" class="text-brand-pink hover:underline">(858) 304-7725</a>
    </p>

  </div>
</section>
