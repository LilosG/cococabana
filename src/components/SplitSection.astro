---
import type { ImageMetadata } from 'astro';
import CoverImage from './CoverImage.astro';
import type { FocalPosition } from '../config/image-focal';

interface Props {
  id?: string;
  image?: ImageMetadata;
  imageAlt: string;
  focal?: FocalPosition;
  focalDesktop?: FocalPosition;
  tone?: 'light' | 'dark' | 'navy';
  imageLeft?: boolean;
  minHeight?: string;
}

const {
  id,
  image,
  imageAlt,
  focal = 'center',
  focalDesktop,
  tone = 'light',
  imageLeft = false,
  minHeight = 'min-h-[560px] md:min-h-[640px]',
} = Astro.props;

const bgClass = {
  light: 'bg-brand-cream',
  dark:  'bg-brand-charcoal',
  navy:  'bg-brand-navy',
}[tone];
const imageSizes = imageLeft
  ? '(min-width: 1280px) 768px, (min-width: 768px) 60vw, 100vw'
  : '(min-width: 1280px) 512px, (min-width: 768px) 40vw, 100vw';
---

<section {id} class:list={[bgClass, 'overflow-hidden']}>
  <div class:list={['max-w-7xl mx-auto grid md:grid-cols-[3fr_2fr] items-stretch', minHeight]}>
    <div class:list={['relative min-h-[380px] md:min-h-0', imageLeft ? 'md:order-1' : 'md:order-2']}>
      {image && (
        <CoverImage
          src={image}
          alt={imageAlt}
          {focal}
          {focalDesktop}
          sizes={imageSizes}
          loading="lazy"
        />
      )}
    </div>
    <div class:list={[
      'px-8 sm:px-10 lg:px-14 py-16 sm:py-20 flex flex-col justify-center',
      imageLeft ? 'md:order-2' : 'md:order-1',
    ]}>
      <slot />
    </div>
  </div>
</section>
