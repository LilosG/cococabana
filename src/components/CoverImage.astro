---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
  DEFAULT_FOCAL_POSITION,
  FOCAL_POSITIONS,
  type FocalPosition,
} from '../config/image-focal';

interface Props {
  src: ImageMetadata;
  alt: string;
  focal?: FocalPosition;
  focalDesktop?: FocalPosition;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const {
  src,
  alt,
  focal = DEFAULT_FOCAL_POSITION,
  focalDesktop,
  sizes,
  loading = 'lazy',
  fetchpriority,
} = Astro.props;

const mobilePosition = FOCAL_POSITIONS[focal];
const desktopPosition = FOCAL_POSITIONS[focalDesktop ?? focal];
---

<Image
  {src}
  {alt}
  layout="full-width"
  {sizes}
  {loading}
  {fetchpriority}
  style={`--focal-mobile: ${mobilePosition}; --focal-desktop: ${desktopPosition};`}
  class="cover-image absolute inset-0"
/>

<style>
  .cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--focal-mobile);
  }

  @media (min-width: 768px) {
    .cover-image {
      object-position: var(--focal-desktop);
    }
  }
</style>
