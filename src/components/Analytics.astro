---
const GA_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---
{GA_ID && (
  <script is:inline define:vars={{ GA_ID }}>
    (function () {
      var NEW_KEY = 'lilos-privacy-v1';
      var OLD_KEY = 'lilos-consent-v1';

      // ── 1. Read opt-out record (new key)
      function readPrivacy() {
        try {
          var raw = localStorage.getItem(NEW_KEY);
          if (!raw) return null;
          var parsed = JSON.parse(raw);
          if (!parsed || typeof parsed.ts !== 'number') return null;
          return parsed;
        } catch (e) {
          return null;
        }
      }

      // ── 2. Migrate old consent key → new privacy key
      function migrateIfNeeded() {
        if (localStorage.getItem(NEW_KEY)) return; // already migrated
        try {
          var oldRaw = localStorage.getItem(OLD_KEY);
          if (!oldRaw) return;
          var old = JSON.parse(oldRaw);
          if (!old || typeof old.ts !== 'number') return;
          if (old.analytics === false) {
            localStorage.setItem(NEW_KEY, JSON.stringify({ optOut: true, ts: old.ts }));
          }
          // analytics === true or absent → default opted-in, no record written
        } catch (e) {}
      }

      // ── 3. GPC check — no DNT
      function hasGPC() {
        return navigator.globalPrivacyControl === true;
      }

      // ── 4. Load GA4
      function initAnalytics() {
        if (window.__lilosGA4Loaded) return;
        window.__lilosGA4Loaded = true;

        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };

        // ── 5. Consent defaults — deny everything ad-related
        window.gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'granted'
        });

        window.gtag('js', new Date());

        // ── 6. Config — no signals, no ads personalization
        window.gtag('config', GA_ID, {
          allow_google_signals: false,
          allow_ad_personalization_signals: false
        });

        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(GA_ID);
        document.head.appendChild(s);

        // ── 8. Delegated link click-tracking.
        document.addEventListener('click', function (e) {
          const phoneLink = e.target.closest('a[href^="tel:"]');
          if (phoneLink) {
            if (typeof gtag === 'function') {
              gtag('event', 'phone_click', {
                link_url: phoneLink.href,
                page_path: window.location.pathname,
                link_location: phoneLink.dataset.analyticsLocation || 'unknown',
              });
            }
            return;
          }

          const link = e.target.closest('a[href*="toasttab.com"]');
          if (!link) return;

          let eventName = 'toast_link_click';
          try {
            const host = new URL(link.href).hostname;
            if (host.includes('tables.toasttab.com')) eventName = 'reservation_click';
            else if (host.includes('order.toasttab.com')) eventName = 'order_click';
            else if (link.href.includes('invoice/lead')) eventName = 'inquiry_form_click';
            else if (link.href.toLowerCase().includes('gift')) eventName = 'gift_card_click';
          } catch (err) {}

          if (typeof gtag === 'function') {
            gtag('event', eventName, {
              link_url: link.href,
              page_path: window.location.pathname,
            });
          }
        }, { passive: true });
      }

      // ── 7. window.lilosPrivacy API
      window.lilosPrivacy = {
        isOptedOut: function () {
          var rec = readPrivacy();
          return rec ? !!rec.optOut : false;
        },
        optOut: function () {
          try {
            localStorage.setItem(NEW_KEY, JSON.stringify({ optOut: true, ts: Date.now() }));
          } catch (e) {}
          window['ga-disable-' + GA_ID] = true;
        },
        optIn: function () {
          try {
            localStorage.setItem(NEW_KEY, JSON.stringify({ optOut: false, ts: Date.now() }));
          } catch (e) {}
          window['ga-disable-' + GA_ID] = false;
          initAnalytics();
        },
      };

      // ── Boot
      migrateIfNeeded();

      if (hasGPC()) {
        // Honor GPC — do not load, do not write a stored record
        return;
      }

      var rec = readPrivacy();
      if (rec && rec.optOut === true) {
        // Visitor has opted out — apply disable flag and skip loading
        window['ga-disable-' + GA_ID] = true;
        return;
      }

      // Default: opted in (no record, or record with optOut: false)
      initAnalytics();
    })();
  </script>
)}
