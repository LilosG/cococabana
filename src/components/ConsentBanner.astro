---
// src/components/ConsentBanner.astro
// Non-blocking notice-and-opt-out banner. Shows once on first visit when no
// lilos-privacy-v1 record exists and GPC is not set. Does not block anything.

interface Props {
  siteName: string;
  privacyPolicyUrl?: string;
}

const { siteName, privacyPolicyUrl = '/privacy' } = Astro.props;
---

<div id="lilos-consent-banner" class="lilos-consent-banner" role="region" aria-label="Privacy notice" hidden>
  <div class="lilos-consent-inner">
    <p class="lilos-consent-text">
      We use Google Analytics to measure site traffic. We do not sell or share your personal information.
      You can opt out at any time.
    </p>
    <div class="lilos-consent-actions">
      <button type="button" id="lilos-consent-optout" class="lilos-btn lilos-btn-secondary">Opt out</button>
      <a href={privacyPolicyUrl} class="lilos-btn lilos-btn-link">Privacy Policy</a>
      <button type="button" id="lilos-consent-gotit" class="lilos-btn lilos-btn-primary">Got it</button>
    </div>
  </div>
</div>

<style>
  .lilos-consent-banner {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    background: var(--consent-bg, #14161a);
    color: var(--consent-text, #f4f4f5);
    border-top: 1px solid var(--consent-border, rgba(255, 255, 255, 0.1));
    padding: 1rem 1.25rem;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.25);
  }

  .lilos-consent-banner[hidden] {
    display: none;
  }

  .lilos-consent-inner {
    max-width: 72rem;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .lilos-consent-text {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    max-width: 48rem;
    color: var(--consent-text, #f4f4f5);
  }

  .lilos-consent-actions {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-shrink: 0;
  }

  .lilos-btn {
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.5rem 1.125rem;
    border-radius: 0.375rem;
    border: 1px solid transparent;
    cursor: pointer;
    transition: opacity 0.15s ease;
    text-decoration: none;
    display: inline-block;
  }

  .lilos-btn:hover {
    opacity: 0.85;
  }

  .lilos-btn:focus-visible {
    outline: 2px solid var(--consent-accent, #7dd3fc);
    outline-offset: 2px;
  }

  .lilos-btn-primary {
    background: var(--consent-accent, #f4f4f5);
    color: var(--consent-bg, #14161a);
  }

  .lilos-btn-secondary {
    background: transparent;
    color: var(--consent-text, #f4f4f5);
    border-color: var(--consent-border, rgba(255, 255, 255, 0.3));
  }

  .lilos-btn-link {
    background: transparent;
    color: var(--consent-accent, #7dd3fc);
    border-color: transparent;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 640px) {
    .lilos-consent-inner {
      flex-direction: column;
      align-items: stretch;
    }
    .lilos-consent-actions {
      justify-content: flex-end;
    }
  }
</style>

<script is:inline>
  (function () {
    var NEW_KEY = 'lilos-privacy-v1';

    function readRecord() {
      try {
        var raw = localStorage.getItem(NEW_KEY);
        if (!raw) return null;
        var parsed = JSON.parse(raw);
        if (!parsed || typeof parsed.ts !== 'number') return null;
        return parsed;
      } catch (e) {
        return null;
      }
    }

    function hasGPC() {
      return navigator.globalPrivacyControl === true;
    }

    function hideBanner() {
      var el = document.getElementById('lilos-consent-banner');
      if (el) el.hidden = true;
    }

    function init() {
      // Don't show if GPC is set or a record already exists.
      if (hasGPC() || readRecord() !== null) return;

      var el = document.getElementById('lilos-consent-banner');
      if (el) el.hidden = false;

      var gotitBtn = document.getElementById('lilos-consent-gotit');
      var optoutBtn = document.getElementById('lilos-consent-optout');

      if (gotitBtn) {
        gotitBtn.addEventListener('click', function () {
          try {
            localStorage.setItem(NEW_KEY, JSON.stringify({ optOut: false, ts: Date.now() }));
          } catch (e) {}
          hideBanner();
        });
      }

      if (optoutBtn) {
        optoutBtn.addEventListener('click', function () {
          if (window.lilosPrivacy && typeof window.lilosPrivacy.optOut === 'function') {
            window.lilosPrivacy.optOut();
          } else {
            try {
              localStorage.setItem(NEW_KEY, JSON.stringify({ optOut: true, ts: Date.now() }));
            } catch (e) {}
          }
          hideBanner();
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>
