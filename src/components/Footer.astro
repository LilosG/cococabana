---
import { Image } from 'astro:assets';
import { venue } from '../data/venue';
import { GPH_NETWORK, GRIND_AND_PROSPER_URL } from '../data/gphNetwork';
import { footer } from '../lib/cms';
import Button from './Button.astro';
import logoImg from '../assets/cococabana-logo-transparent.png';

const year = new Date().getFullYear();
const portfolio = GPH_NETWORK.filter((v) => v.url !== venue.url);
---

<footer class="bg-brand-charcoal text-brand-cream">
  <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-12 sm:py-14 grid gap-y-10 gap-x-8 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,0.75fr)_minmax(0,1.15fr)_auto] lg:gap-x-10 xl:gap-x-12">
    <div>
      <Image
        src={logoImg}
        alt={`${venue.name} ${venue.tagline}`}
        loading="lazy"
        class="h-16 w-auto mb-4"
      />
      <p class="text-brand-cream/70 text-sm max-w-xs leading-relaxed">{footer.description}</p>
      <nav aria-label="Cococabana social media" class="mt-3 -ml-3 flex items-center gap-1">
        <a
          href={venue.social.instagram}
          aria-label="Cococabana Rooftop Bar on Instagram"
          target="_blank"
          rel="noopener noreferrer"
          class="flex size-11 items-center justify-center rounded-full text-brand-cream/70 transition-colors hover:text-brand-pink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-pink"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="size-5">
            <rect x="2" y="2" width="20" height="20" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
          </svg>
        </a>
        <a
          href={venue.social.facebook}
          aria-label="Cococabana Rooftop Bar on Facebook"
          target="_blank"
          rel="noopener noreferrer"
          class="flex size-11 items-center justify-center rounded-full text-brand-cream/70 transition-colors hover:text-brand-pink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-pink"
        >
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="size-5">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3V2z" />
          </svg>
        </a>
      </nav>
    </div>

    <div>
      <h3 class="uppercase tracking-label text-xs text-brand-pink mb-4">{footer.exploreHeading}</h3>
      <ul class="space-y-3 text-sm">
        <li><a href={footer.exploreLinks[0].href} class="hover:text-brand-pink transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-pink">{footer.exploreLinks[0].label}</a></li>
        <li><a href={footer.exploreLinks[1].href} class="hover:text-brand-pink transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-pink">{footer.exploreLinks[1].label}</a></li>
        <li><a href={footer.exploreLinks[2].href} class="hover:text-brand-pink transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-pink">{footer.exploreLinks[2].label}</a></li>
        <li><a href={footer.exploreLinks[3].href} class="hover:text-brand-pink transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-pink">{footer.exploreLinks[3].label}</a></li>
        <li><a href={footer.exploreLinks[4].href} class="hover:text-brand-pink transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-pink">{footer.exploreLinks[4].label}</a></li>
        <li><a href={footer.exploreLinks[5].href} class="hover:text-brand-pink transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-pink">{footer.exploreLinks[5].label}</a></li>
        <li><a href={footer.exploreLinks[6].href} class="hover:text-brand-pink transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-pink">{footer.exploreLinks[6].label}</a></li>
      </ul>
    </div>

    <div>
      <h3 class="uppercase tracking-label text-xs text-brand-pink mb-4">{footer.visitHeading}</h3>
      <a href={venue.mapsUrl} target="_blank" rel="noopener noreferrer" class="text-sm leading-relaxed hover:text-brand-pink transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-pink">
        {venue.address.street}<br />
        {venue.address.city}, {venue.address.state} {venue.address.zip}
      </a>
      <p class="text-sm mt-3">
        <a href={venue.phoneHref} class="hover:text-brand-pink transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-pink">{venue.phone}</a>
      </p>
      <p class="text-sm mt-3 text-brand-cream/70">
        {venue.hours.shortSummary}
      </p>

    </div>

    <div>
      <h3 class="uppercase tracking-label text-xs text-brand-pink mb-4">{footer.reserveHeading}</h3>
      <Button href={venue.reservationsUrl} variant="primary" external>{footer.reserveCtaLabel}</Button>
    </div>
  </div>

  <div class="border-t border-brand-cream/10">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-5">
      <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-8">
        <a href={GRIND_AND_PROSPER_URL} target="_blank" rel="noopener noreferrer"
          class="uppercase tracking-label text-xs text-brand-cream/40 hover:text-brand-pink transition-colors whitespace-nowrap focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-pink">{footer.hospitalityLabel}</a>
        <div class="flex flex-wrap gap-x-6 gap-y-2">
          {portfolio.map((v) => (
            <a href={v.url} target="_blank" rel="noopener noreferrer"
              class="text-xs text-brand-cream/50 hover:text-brand-cream transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-pink">
              {v.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="border-t border-brand-cream/10 px-6 sm:px-8 lg:px-12 py-5 text-xs text-brand-cream/50 flex flex-col sm:flex-row justify-between items-center gap-3">
    <p>&copy; {year} {venue.name}. {footer.copyrightSuffix}</p>
    <div class="flex items-center gap-6">
      <a href="/privacy#choices" class="text-brand-cream/50 hover:text-brand-pink text-[13px] transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-pink">Your Privacy Choices</a>
      <a href={footer.agencyUrl} target="_blank" rel="noopener noreferrer"
        class="text-brand-cream/50 hover:text-brand-pink text-[13px] transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-pink">{footer.agencyLabel}</a>
    </div>
  </div>
</footer>
