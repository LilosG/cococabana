---
interface Props {
  image: string;
  imageAlt: string;
  imagePosition?: string;
  category: string;
  title: string;
  description: string;
  detail?: string;
  href?: string;
}

const {
  image,
  imageAlt,
  imagePosition = 'object-center',
  category,
  title,
  description,
  detail,
  href,
} = Astro.props;

const Tag = href ? 'a' : 'article';
---

<Tag
  href={href}
  class:list={[
    'flex flex-col bg-brand-cream border border-brand-charcoal/8 overflow-hidden',
    href && 'group',
  ]}
>
  <div class="aspect-[4/3] overflow-hidden">
    <img
      src={image}
      alt={imageAlt}
      loading="lazy"
      class:list={['w-full h-full object-cover transition-transform duration-500', imagePosition, href ? 'group-hover:scale-105' : 'hover:scale-105']}
    />
  </div>
  <div class="p-6 flex flex-col flex-1">
    <p class="text-xs uppercase tracking-label text-brand-pink mb-2">{category}</p>
    <h3 class="font-display uppercase text-sm tracking-feature text-brand-charcoal mb-3 leading-snug">{title}</h3>
    <p class="text-brand-charcoal/60 text-sm leading-relaxed mb-4 flex-1">{description}</p>
    {detail && (
      <p class="text-xs uppercase tracking-label text-brand-charcoal/40 pt-4 border-t border-brand-charcoal/10">{detail}</p>
    )}
    {href && (
      <p class="text-xs uppercase tracking-label text-brand-pink mt-4 group-hover:underline">Learn More →</p>
    )}
  </div>
</Tag>
