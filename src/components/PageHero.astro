---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type FocalPosition = 'center' | 'top' | 'bottom' | 'left-lower' | 'right-lower';

interface Props {
  image?: ImageMetadata;
  imageAlt: string;
  imagePosition?: string;
  focalPosition?: FocalPosition;
  heightClass?: string;
}

const {
  image,
  imageAlt,
  imagePosition = 'object-center',
  focalPosition,
  heightClass = 'min-h-[80vh]',
} = Astro.props;

const focalPositions: Record<FocalPosition, string> = {
  center: '50% 50%',
  top: '50% 0%',
  bottom: '50% 100%',
  'left-lower': '40% 67%',
  'right-lower': '60% 67%',
} as const;

const resolvedFocalPosition = focalPosition ? focalPositions[focalPosition] : undefined;
---

<section class:list={['relative flex items-end overflow-hidden', heightClass]}>
  <div class="absolute inset-0">
    {image && (
      <Image
        src={image}
        alt={imageAlt}
        layout="full-width"
        style={resolvedFocalPosition ? `object-position: ${resolvedFocalPosition}` : undefined}
        class:list={['w-full h-full object-cover', imagePosition]}
        fetchpriority="high"
        loading="eager"
      />
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-brand-charcoal/85 via-brand-charcoal/30 to-transparent"></div>
    <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-brand-charcoal/40 to-transparent"></div>
  </div>
  <div class="relative z-10 px-6 sm:px-8 lg:px-12 pb-20 sm:pb-24 w-full text-brand-cream">
    <slot />
  </div>
</section>
