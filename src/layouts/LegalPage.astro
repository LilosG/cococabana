---
import Layout from './Layout.astro';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '');
---
<Layout title={`${title} — Cococabana Rooftop Bar`} description={description}>
  <section class="legal-page bg-brand-cream px-6 sm:px-8 lg:px-12 py-20 sm:py-28" aria-labelledby="legal-title">
    <div class="max-w-2xl mx-auto">
      <header class="mb-12">
        <p class="uppercase tracking-label text-xs text-brand-charcoal/70 mb-4">Legal</p>
        <h1 id="legal-title" class="font-display text-section-xl leading-display uppercase text-brand-charcoal mb-6">{title}</h1>
        <p class="text-sm text-brand-charcoal/70">Last updated: <time datetime="2026-10-29">October 29, 2026</time></p>
        <nav aria-label="Legal information" class="flex flex-wrap gap-x-6 gap-y-3 mt-6 text-sm">
          <a href="/privacy" aria-current={currentPath === '/privacy' ? 'page' : undefined}>Privacy Policy</a>
          <a href="/terms" aria-current={currentPath === '/terms' ? 'page' : undefined}>Terms of Service</a>
          <a href="/privacy#choices">Your Privacy Choices</a>
        </nav>
      </header>
      <div class="legal-content"><slot /></div>
    </div>
  </section>
</Layout>
<style>
  @layer components {
    .legal-page { overflow-wrap: anywhere; }
    .legal-page :global(a) { color: var(--color-brand-charcoal); text-decoration: underline; text-underline-offset: 3px; }
    .legal-page :global(a:hover) { text-decoration-thickness: 2px; }
    .legal-page :global(a:focus-visible), .legal-page :global(button:focus-visible) { outline: 2px solid var(--color-brand-charcoal); outline-offset: 4px; }
    .legal-content :global(h2) { font-family: var(--font-display); font-size: 1.25rem; font-weight: 500; line-height: 1.4; text-transform: uppercase; letter-spacing: var(--tracking-feature); color: var(--color-brand-charcoal); margin: 2.5rem 0 1rem; }
    .legal-content :global(p), .legal-content :global(address), .legal-content :global(li) { font-family: var(--font-body); font-size: 1rem; line-height: 1.75; color: var(--color-brand-charcoal); }
    .legal-content :global(p) { margin-bottom: 1.25rem; }
    .legal-content :global(address) { font-style: normal; }
    .legal-content :global(ul) { padding-left: 1.5rem; list-style: disc; margin-bottom: 1.25rem; }
    .legal-content :global(li) { margin-bottom: 0.5rem; }
    .legal-content :global([id]) { scroll-margin-top: 6rem; }
  }
</style>
